#!/bin/bash
# dots: intentionally small, allowlist-only dotfile synchronization.
# Compatible with macOS /bin/bash 3.2.

set -u
umask 077
# Never allow a Git pager to consume sync confirmation input on a terminal.
GIT_PAGER='cat'
# Do not let a managed $HOME/.gitconfig alter dots' own Git operations.
GIT_CONFIG_GLOBAL=/dev/null
export GIT_PAGER GIT_CONFIG_GLOBAL

DOTS_HOME=${HOME:?HOME must be set}
case $DOTS_HOME in /*) ;; *) printf 'dots: %s\n' "HOME must be an absolute path" >&2; exit 1 ;; esac
DOTS_DATA=${DOTS_DATA_DIR:-"$DOTS_HOME/.local/share/dots"}
# Git below runs from HOME, so a relative data folder is made absolute first.
case $DOTS_DATA in /*) ;; *) DOTS_DATA=$PWD/$DOTS_DATA ;; esac
REPO="$DOTS_DATA/repo.git"
GIT=${DOTS_GIT:-/usr/bin/git}
GITLEAKS=${DOTS_GITLEAKS:-gitleaks}
GH=${DOTS_GH:-gh}
# Test and self-hosting overrides. Normal no-argument init derives its owner from gh.
DEFAULT_REMOTE=${DOTS_DEFAULT_REMOTE:-}
DEFAULT_GITHUB_REPO=${DOTS_DEFAULT_GITHUB_REPO:-}
DEFAULT_GITHUB_REPO_NAME=${DOTS_DEFAULT_GITHUB_REPO_NAME:-dotfiles}
MANIFEST=.config/dots/manifest
TAB=$(printf '\t')
NL='
'
# Machine-local choice of which repository files this Mac uses. Never synced.
SELECTION=$DOTS_DATA/selection

say() { printf '%s\n' "$*"; }
fail() { printf 'dots: %s\n' "$*" >&2; exit 1; }
usage() { cat <<'EOF'
Usage:
  dots status                  show whether this Mac is up to date and what you edited here
  dots sync                    bring this Mac up to date with the repository
  dots update                  send your edits and shared-file changes as a pull request
  dots select                  choose which repository files this Mac uses
  dots init [remote] [branch]  connect this Mac to your dotfiles repository (once per Mac)
    --backup-existing          back up differing local files, then use the repository's
    --discover                 only list the files dots would suggest
EOF
}

require_tool() {
  case $1 in
    */*) test -x "$1" || fail "required dependency is unavailable: $1" ;;
    *) command -v "$1" >/dev/null 2>&1 || fail "required dependency is unavailable: $1" ;;
  esac
}

require_dependencies() {
  require_tool "$GIT"
  require_tool "$GITLEAKS"
}

# Runs from HOME: pathspecs are relative to the current folder when that folder is
# inside the work tree, so from ~/projects a manifest path would name the wrong file.
git_repo() { "$GIT" -C "$DOTS_HOME" --no-pager --git-dir="$REPO" --work-tree="$DOTS_HOME" "$@"; }
git_dir() { "$GIT" --no-pager --git-dir="$1" "${@:2}"; }

safe_branch() {
  "$GIT" check-ref-format --branch "$1" >/dev/null 2>&1 || fail "invalid branch name"
}

mktemp_dir() {
  mktemp -d "${TMPDIR:-/tmp}/dots.XXXXXX" || fail "cannot create temporary directory"
}

valid_manifest_path() {
  line=$1
  test -n "$line" || return 1
  # v1 paths are printable ASCII. This avoids ambiguous Unicode whitespace and
  # platform-dependent normalization, as well as unsafe Git pathspec characters.
  # Byte-wise in the C locale, so any non-ASCII byte or control character matches.
  local LC_ALL=C
  case $line in *[!\ -~]*) return 1 ;; esac
  case $line in
    '#'*|:*|*'\\'*|*'"'*|.gitleaks.toml|/*|./*|*/|*'//'*|*'..'*|*'?'*|*'*'*|*'['*|*']'*|*'{'*|*'}'*) return 1 ;;
  esac
  case "/$line/" in */./*|*/../*) return 1 ;; esac
  # grep above is line-based, so a newline must be refused explicitly.
  case $line in *' '*|*$'\t'*|*$'\n'*|*$'\r'*) return 1 ;; esac
  return 0
}

# A manifest is parsed into a private newline-delimited file. Paths cannot contain
# controls, so this representation is unambiguous.
validate_manifest_file() {
  manifest_file=$1
  out_file=$2
  test -f "$manifest_file" && test ! -L "$manifest_file" || return 1
  : >"$out_file" || return 1
  while IFS= read -r line || test -n "$line"; do
    case $line in ''|'#'*) continue ;; esac
    valid_manifest_path "$line" || return 1
    grep -F -x -- "$line" "$out_file" >/dev/null 2>&1 && return 1
    printf '%s\n' "$line" >>"$out_file" || return 1
  done <"$manifest_file"
  return 0
}

# Reject symlinked parents as well as a symlink at the final name. This prevents an
# allowlisted relative path from escaping HOME through an existing parent link.
safe_live_path() {
  rel=$1
  current=$DOTS_HOME
  oldifs=$IFS
  IFS=/
  set -- $rel
  IFS=$oldifs
  remaining=$#
  for component in "$@"; do
    current=$current/$component
    remaining=$((remaining - 1))
    if test -L "$current"; then return 1; fi
    if test "$remaining" -gt 0 && test -e "$current" && test ! -d "$current"; then return 1; fi
  done
  return 0
}

is_reserved_path() {
  path=$1
  case $DOTS_DATA in
    "$DOTS_HOME"/*)
      data_path=${DOTS_DATA#"$DOTS_HOME"/}
      test "$path" = "$data_path" && return 0
      case $path in "$data_path"/*) return 0 ;; esac
      ;;
  esac
  return 1
}

validate_live_paths() {
  list=$1
  safe_live_path "$MANIFEST" || return 1
  is_reserved_path "$MANIFEST" && return 1
  test -f "$DOTS_HOME/$MANIFEST" && test ! -L "$DOTS_HOME/$MANIFEST" || return 1
  while IFS= read -r path; do
    is_reserved_path "$path" && return 1
    safe_live_path "$path" || return 1
    if test -e "$DOTS_HOME/$path" && { test -d "$DOTS_HOME/$path" || test -L "$DOTS_HOME/$path"; }; then return 1; fi
  done <"$list"
  return 0
}

manifest_from_revision() {
  gitdir=$1
  rev=$2
  out=$3
  tmp=$4
  git_dir "$gitdir" show "$rev:$MANIFEST" >"$tmp" 2>/dev/null || return 1
  validate_manifest_file "$tmp" "$out"
}

# Exact whole-line membership. grep -F would read a newline in $1 as two patterns.
path_in_list() {
  case $1 in *"$NL"*) return 1 ;; esac
  grep -F -x -- "$1" "$2" >/dev/null 2>&1
}

# Check the entire candidate tree. Git path output is NUL-delimited, and failures
# intentionally do not repeat an untrusted filename or file body.
validate_tree() {
  gitdir=$1
  rev=$2
  list=$3
  temp=$4
  manifest_from_revision "$gitdir" "$rev" "$list" "$temp/manifest" || return 1
  entry_file=$temp/tree
  git_dir "$gitdir" ls-tree -r -z "$rev" >"$entry_file" || return 1
  # Every entry must be a regular file named exactly by the manifest (or be the
  # manifest). A name with a newline can never match, so it is refused outright.
  : >"$temp/tree-paths"
  while IFS= read -r -d '' entry; do
    meta=${entry%%$'\t'*}
    path=${entry#*$'\t'}
    mode=${meta%% *}
    test "$mode" = 100644 -o "$mode" = 100755 || return 1
    case $path in *"$NL"*) return 1 ;; esac
    printf '%s\n' "$path" >>"$temp/tree-paths"
  done <"$entry_file"
  { cat "$list"; printf '%s\n' "$MANIFEST"; } >"$temp/tree-allowed"
  list_minus "$temp/tree-paths" "$temp/tree-allowed" "$temp/tree-extra"
  test ! -s "$temp/tree-extra" || return 1
  # A candidate manifest cannot approve nonexistent paths, which would otherwise
  # make the later path-limited checkout fail after repository metadata is moved.
  list_minus "$list" "$temp/tree-paths" "$temp/tree-missing"
  test ! -s "$temp/tree-missing" || return 1
  while IFS= read -r path; do
    is_reserved_path "$path" && return 1
  done <"$list"
  return 0
}

# Run gitleaks with exactly its default rules: run_gitleaks dir|git target [flags].
# A private config extends them, so a repository .gitleaks.toml or the environment
# cannot replace them (an empty config such as /dev/null would load no rules), and
# the .gitleaksignore lookup points at an empty folder rather than the current
# directory. Findings are reported by file, line, and rule only; values never are.
run_gitleaks() {
  gl_mode=$1
  gl_target=$2
  shift 2
  gl_dir=$(mktemp -d "${TMPDIR:-/tmp}/dots-gitleaks.XXXXXX") || return 1
  { printf '[extend]\nuseDefault = true\n' >"$gl_dir/rules.toml" &&
    printf '{{ range . }}{{ .File }}\t{{ .StartLine }}\t{{ .RuleID }}\n{{ end }}' >"$gl_dir/report.tmpl" &&
    mkdir "$gl_dir/ignore"; } || { rm -rf "$gl_dir"; return 1; }
  (
    unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML
    # Scanning a folder from inside it keeps report paths relative to it.
    if test "$gl_mode" = dir; then cd "$gl_target" || exit 2; gl_target=.; fi
    "$GITLEAKS" "$gl_mode" --no-banner --no-color --redact=100 --exit-code 3 --config "$gl_dir/rules.toml" --gitleaks-ignore-path "$gl_dir/ignore" --report-format template --report-template "$gl_dir/report.tmpl" --report-path "$gl_dir/report" "$@" "$gl_target" >/dev/null 2>&1
  )
  gl_status=$?
  case $gl_status in
    0) ;;
    3)
      say "gitleaks found what looks like a secret (values are not shown):" >&2
      # Only names that are valid manifest paths (printable ASCII, no whitespace or
      # control characters), and for history scans only names in that revision's
      # manifest (GL_SHOWN), are shown. A history-only name could itself be a secret.
      gl_n=0
      cat "$gl_dir/report" >"$gl_dir/report.lines" 2>/dev/null || : >"$gl_dir/report.lines"
      while IFS=$TAB read -r gl_file gl_line gl_rule; do
        gl_n=$((gl_n + 1))
        test "$gl_n" -le 20 || continue
        { valid_manifest_path "$gl_file" && { test -z "${GL_SHOWN:-}" || path_in_list "$gl_file" "$GL_SHOWN"; }; } || gl_file='a file in the repository history'
        case $gl_line in ''|*[!0-9]*) gl_line='?' ;; esac
        case $gl_rule in ''|*[!A-Za-z0-9_-]*) gl_rule=unknown ;; esac
        printf '  %s, line %s (%s)\n' "$gl_file" "$gl_line" "$gl_rule" >&2
      done <"$gl_dir/report.lines"
      if test "$gl_n" -gt 20; then printf '  and %d more\n' $((gl_n - 20)) >&2; fi
      if test "$gl_n" -eq 0; then printf '  (no details available)\n' >&2; fi ;;
    *) say "gitleaks could not complete the scan (exit status $gl_status)" >&2 ;;
  esac
  rm -rf "$gl_dir"
  return "$gl_status"
}

# Fail with the given advice when the scan found a secret (status 3), or with a
# plain message when the scanner itself failed.
scan_fail() {
  if test "$1" -eq 3; then fail "$2"; fi
  fail "the credential scan could not run, so nothing was changed"
}

scan_git_revision() {
  # gitleaks receives only a revision. Findings name only files in its manifest.
  GL_SHOWN=$(mktemp "${TMPDIR:-/tmp}/dots-shown.XXXXXX") || return 1
  { printf '%s\n' "$MANIFEST"; git_dir "$1" show "$2:$MANIFEST" 2>/dev/null; } >"$GL_SHOWN"
  run_gitleaks git "$1" --log-opts "$2"
  sg_status=$?
  rm -f "$GL_SHOWN"
  GL_SHOWN=
  return "$sg_status"
}

copy_live_candidates_for_scan() {
  list=$1
  destination=$2
  while IFS= read -r path; do
    test -e "$DOTS_HOME/$path" || continue
    test -f "$DOTS_HOME/$path" && test ! -L "$DOTS_HOME/$path" || return 1
    mkdir -p "$destination/$(dirname "$path")" || return 1
    cp -p "$DOTS_HOME/$path" "$destination/$path" || return 1
  done <"$list"
}

scan_live_candidates() {
  list=$1
  temp=$2
  scan=$temp/live-scan
  mkdir -p "$scan" || return 1
  copy_live_candidates_for_scan "$list" "$scan" || return 1
  run_gitleaks dir "$scan"
}

scan_directory() {
  run_gitleaks dir "$1"
}

append_unique_list() {
  awk 'FILENAME == ARGV[1] { seen[$0] = 1; next } !($0 in seen) { seen[$0] = 1; print }' "$2" "$1" >"$2.append" &&
    cat "$2.append" >>"$2" && rm -f "$2.append"
}

list_with_manifest() {
  list=$1
  out=$2
  : >"$out"
  printf '%s\n' "$MANIFEST" >>"$out"
  append_unique_list "$list" "$out"
}

current_branch() {
  git_repo config --get dots.branch 2>/dev/null
}

ensure_initialized() {
  test -d "$REPO" || fail "not initialized, run: dots init <remote> [branch]"
  test "$(git_repo config --get dots.initialized 2>/dev/null || true)" = true || fail "repository is not a completed dots initialization"
  branch=$(current_branch || true)
  test -n "$branch" || fail "repository has no configured branch"
  safe_branch "$branch"
}

live_manifest_list() {
  out=$1
  safe_live_path "$MANIFEST" || return 1
  validate_manifest_file "$DOTS_HOME/$MANIFEST" "$out"
}

head_revision() { git_repo rev-parse HEAD 2>/dev/null; }

# ── Path lists ──────────────────────────────────────────────
# Lists are newline-delimited files of validated manifest paths.
list_union() { cat "$1" "$2" | LC_ALL=C sort -u >"$3"; }
# List operations keep $1's order and match whole lines exactly, one process each.
list_intersect() {
  awk 'FILENAME == ARGV[1] { seen[$0] = 1; next } ($0 in seen)' "$2" "$1" >"$3"
}
list_minus() {
  awk 'FILENAME == ARGV[1] { seen[$0] = 1; next } !($0 in seen)' "$2" "$1" >"$3"
}
list_count() { wc -l <"$1" | tr -d ' '; }

# ── Machine selection ───────────────────────────────────────
# Format: a comment header, then "use <path>", "skip <path>", or "pending <path>"
# lines. Pending paths were shared from this Mac by an update PR that is not merged
# yet; they become used once they appear in the manifest. "ignore <path>" marks a
# discovered file this Mac chose not to share, so dots update lists it last instead
# of as new. Paths are validated manifest paths, so they contain no whitespace.
selection_list() {
  kind=$1
  out=$2
  : >"$out"
  test -f "$SELECTION" && test ! -L "$SELECTION" || return 0
  awk -v kind="$kind" '$1 == kind && NF == 2 { print $2 }' "$SELECTION" | while IFS= read -r path; do
    valid_manifest_path "$path" && printf '%s\n' "$path"
  done >"$out"
  return 0
}

# Load use/skip lists into temp. Before a selection exists (initial setup or an
# upgrade from a version without one), every repository file counts as used.
load_selection() {
  temp=$1
  manifest_union=$2
  if test -f "$SELECTION"; then
    selection_list use "$temp/use"
    selection_list skip "$temp/skip"
    selection_list pending "$temp/pending"
    selection_list ignore "$temp/ignore"
  else
    cp "$manifest_union" "$temp/use" || return 1
    : >"$temp/skip"
    : >"$temp/pending"
    : >"$temp/ignore"
  fi
  : >"$temp/newly-used"
  pending_arrived "$temp" "$manifest_union"
}

# Pending paths that reached the given manifest are used on this Mac from now on.
# They count as newly used, so a copy edited since the PR is confirmed or backed up
# rather than treated as a collision.
pending_arrived() {
  list_intersect "$1/pending" "$2" "$1/arrived"
  cat "$1/arrived" >>"$1/use"
  cat "$1/arrived" >>"$1/newly-used"
  list_minus "$1/pending" "$1/arrived" "$1/pending.next" && mv -f "$1/pending.next" "$1/pending"
}

# Save use/skip entries for paths present in the given manifest list, plus pending
# and ignore entries for paths outside it. Without an ignore list the saved ignore
# entries are kept, so only update, which offers those files, has to pass one.
write_selection() {
  use=$1
  skip=$2
  manifest=$3
  pending=${4:-/dev/null}
  tmp=$(mktemp "$DOTS_DATA/.selection.XXXXXX") || return 1
  ignore=${5:-$tmp.ignore}
  if test -z "${5:-}"; then
    : >"$ignore" && selection_list ignore "$ignore" || { rm -f "$tmp" "$tmp.ignore"; return 1; }
  fi
  {
    printf '%s\n' '# dots selection v1: repository files this Mac uses. Change with: dots select'
    while IFS= read -r path; do
      if path_in_list "$path" "$use"; then printf 'use %s\n' "$path"; fi
    done <"$manifest"
    while IFS= read -r path; do
      if ! path_in_list "$path" "$use" && path_in_list "$path" "$skip"; then printf 'skip %s\n' "$path"; fi
    done <"$manifest"
    while IFS= read -r path; do
      if ! path_in_list "$path" "$manifest" && valid_manifest_path "$path"; then printf 'pending %s\n' "$path"; fi
    done <"$pending"
    while IFS= read -r path; do
      if ! path_in_list "$path" "$manifest" && ! path_in_list "$path" "$pending" && valid_manifest_path "$path"; then printf 'ignore %s\n' "$path"; fi
    done <"$ignore"
  } >"$tmp" || { rm -f "$tmp" "$tmp.ignore"; return 1; }
  rm -f "$tmp.ignore"
  mv -f "$tmp" "$SELECTION"
}

validate_current_state() {
  temp=$1
  head=$(head_revision) || return 1
  validate_tree "$REPO" "$head" "$temp/head-manifest" "$temp" || return 1
  live_manifest_list "$temp/live-manifest" || return 1
  while IFS= read -r path; do is_reserved_path "$path" && return 1; done <"$temp/live-manifest"
  list_union "$temp/head-manifest" "$temp/live-manifest" "$temp/manifest-union"
  load_selection "$temp" "$temp/manifest-union" || return 1
  # Lines added to the live manifest by hand on this Mac are used here. The live
  # manifest only differs from HEAD through local edits, since sync rewrites both.
  list_minus "$temp/live-manifest" "$temp/head-manifest" "$temp/hand-added-all"
  list_minus "$temp/hand-added-all" "$temp/skip" "$temp/hand-added"
  cat "$temp/hand-added" >>"$temp/use"
  # Only files this Mac uses are live-checked, scanned, reported, or written.
  list_intersect "$temp/manifest-union" "$temp/use" "$temp/selected-manifest"
  list_minus "$temp/manifest-union" "$temp/use" "$temp/unselected"
  validate_live_paths "$temp/selected-manifest" || return 1
  list_with_manifest "$temp/selected-manifest" "$temp/selected-paths"
  list_with_manifest "$temp/live-manifest" "$temp/live-paths"
  list_with_manifest "$temp/head-manifest" "$temp/head-paths"
  : >"$temp/all-paths"
  append_unique_list "$temp/head-paths" "$temp/all-paths"
  append_unique_list "$temp/live-paths" "$temp/all-paths"
}

stage_approved_paths() {
  old=$1
  new=$2
  # Do not accept a pre-existing partial index or conflict state.
  git_repo diff --cached --quiet || return 1
  git_repo diff --name-only --diff-filter=U | grep . >/dev/null 2>&1 && return 1
  set --
  while IFS= read -r path; do set -- "$@" "$path"; done <"$new"
  git_repo add -A -- "$@" || return 1
  # Removing an allowlist entry means removing it from the repository, not deleting
  # the live file. The old list is itself a validated manifest.
  while IFS= read -r path; do
    test "$path" = "$MANIFEST" && continue
    path_in_list "$path" "$new" && continue
    git_repo rm --cached --ignore-unmatch -- "$path" >/dev/null || return 1
  done <"$old"
  return 0
}

ensure_identity() {
  git_repo var GIT_AUTHOR_IDENT >/dev/null 2>&1 || return 1
}

safe_github_component() {
  test -n "$1" || return 1
  case $1 in *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-]*) return 1 ;; esac
  return 0
}

github_repository_from_gh() {
  require_tool "$GH"
  "$GH" auth status >/dev/null 2>&1 || return 1
  owner=$("$GH" api user --jq .login 2>/dev/null) || return 1
  safe_github_component "$owner" || return 1
  safe_github_component "$DEFAULT_GITHUB_REPO_NAME" || return 1
  printf '%s/%s\n' "$owner" "$DEFAULT_GITHUB_REPO_NAME"
}

enable_gh_git_credentials() {
  # We ignore a managed ~/.gitconfig, but gh's credential helper is still needed
  # for the account-derived HTTPS remote. The empty value first clears helpers from
  # the system config (the macOS Keychain helper fails when the Keychain will not
  # answer a background process), so only gh is asked. Git 2.18+ supports this.
  GIT_CONFIG_COUNT=2
  GIT_CONFIG_KEY_0=credential.helper
  GIT_CONFIG_VALUE_0=
  GIT_CONFIG_KEY_1=credential.helper
  GIT_CONFIG_VALUE_1='!gh auth git-credential'
  export GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0 GIT_CONFIG_KEY_1 GIT_CONFIG_VALUE_1
}

# Fetch the tracked branch from origin, with gh's credentials for a GitHub origin.
fetch_origin() {
  case $(git_repo remote get-url origin 2>/dev/null) in
    https://github.com/*) command -v gh >/dev/null 2>&1 && enable_gh_git_credentials ;;
  esac
  git_repo fetch --no-tags origin "refs/heads/$1:refs/remotes/origin/$1" >/dev/null 2>&1
}

# A newly created remote needs one safe, versioned object before init can validate it.
# This is metadata bootstrap, not a configuration template or an import of HOME.
seed_new_repository() {
  remote=$1
  branch=$2
  seed=$3
  "$GIT" init --quiet "$seed" || return 1
  "$GIT" -C "$seed" config user.name "dots bootstrap" || return 1
  "$GIT" -C "$seed" config user.email "dots@local.invalid" || return 1
  mkdir -p "$seed/.config/dots" || return 1
  : >"$seed/$MANIFEST" || return 1
  "$GIT" -C "$seed" add -- "$MANIFEST" || return 1
  "$GIT" -C "$seed" commit --quiet -m "Initialize dots manifest" || return 1
  "$GIT" -C "$seed" branch -M "$branch" || return 1
  "$GIT" -C "$seed" remote add origin "$remote" || return 1
  "$GIT" -C "$seed" push --quiet origin "HEAD:refs/heads/$branch"
}

create_default_github_repository() {
  remote=$1
  github_repository=$2
  branch=$3
  temp=$4
  require_tool "$GH"
  "$GH" auth status >/dev/null 2>&1 || fail "GitHub CLI is not authenticated; run gh auth login or pass an explicit remote"
  if "$GH" repo view "$github_repository" --json nameWithOwner >/dev/null 2>&1; then
    fail "could not clone the existing default repository; check network access and permissions"
  fi
  test -t 0 && test -t 1 || fail "default repository is missing; rerun dots init from an interactive terminal to create it"
  printf 'GitHub repository %s is unavailable. Create it privately with an empty dots manifest? [y/N] ' "$github_repository" >&2
  IFS= read -r answer || fail "repository creation cancelled"
  case $answer in y|Y|yes|YES) ;; *) say "init cancelled"; exit 0 ;; esac
  "$GH" repo create "$github_repository" --private --description "Allowlisted dots configuration" >/dev/null 2>&1 || fail "could not create private GitHub repository $github_repository"
  seed_new_repository "$remote" "$branch" "$temp/seed" || fail "repository was created but its initial manifest could not be pushed"
  say "created private GitHub repository $github_repository"
  return 0
}

# ── Discovery ───────────────────────────────────────────────
# Candidates come from a generic scan, never a list of tools: dotfiles directly in
# HOME, everything under ~/.config, and config-like files up to two levels inside
# any other ~/.<name> folder. An optional shared rules file adds or drops paths.
# Helpers here can run outside a subshell, so their variables carry prefixes to
# avoid clobbering callers (update_command uses $base, for example).
DISCOVER_RULES=.config/dots/discover
DISCOVER_MAX_BYTES=65536

# Name filters for discovery, applied to "kind<TAB>path" lines in one pass. Kind is
# "any", "config" (only names that look like hand-edited configuration count, used
# inside ~/.<name> folders), or "included" (named by an include rule). Everything
# is matched case-insensitively except the configuration-name test. Drops names that
# hold credentials, caches, or machine-local state wherever they appear; gitleaks
# still scans every chosen file before a push.
filter_candidate_names() {
  # The C locale keeps tolower() to ASCII (in a Turkish locale "I" would fold to a
  # dotless i and slip past "private"), as the tr it replaced did.
  LC_ALL=C awk -F '\t' -v rules="$DISCOVER_RULES" '
    function excluded(path,    l, b) {
      if (path == rules) return 0
      if (index(path, ".config/dots/") == 1) return 1
      l = "/" tolower(path)
      b = l; sub(/.*\//, "", b)
      # Folders of credentials or keys, and files known to hold them.
      if (l ~ /^\/\.(ssh|gnupg|kube|aws|azure)\// || l ~ /^\/\.config\/(gh|op|gcloud|pass|chezmoi|configstore)\// || l == "/.config/hub" || l == "/.docker/config.json") return 1
      # Caches, logs, transcripts, private content, and other machine-local state.
      if (l ~ /\/(\.git|\.system|logs|log|tmp|temp|runtime|sessions|state|history|projects|node_modules|backups|\.trash|memories|memory|attachments|transcripts)\// || l ~ /[-_]logs\//) return 1
      # MCP server configurations usually carry API keys in their environment blocks.
      if (l ~ /auth|credential|token|secret|private|password|passwd|mcp|history|session|state|backup|cache|telemetry|analytics/) return 1
      if (b ~ /^\.(netrc|npmrc|pypirc|pgpass|my\.cnf|git-credentials|env)$/ || b ~ /^\.env\./ || b ~ /\.env$/ || b ~ /\.env\./) return 1
      if (b ~ /\.(pem|key|p12|pfx|crt|db|lock|log|pid|bak|old|swp)$/ || b ~ /\.keychain|\.db-|\.sqlite|~$|^id_/) return 1
      if (b ~ /^\.(ds_store|cfusertextencoding|localized|viminfo|lesshst|wget-hsts|xauthority)$/ || b ~ /^\.zcompdump/) return 1
      # Application state that lives beside configuration and holds account details.
      if (b == ".claude.json") return 1
      return 0
    }
    function config_like(path,    b) {
      b = path; sub(/.*\//, "", b)
      return b ~ /\.(json|jsonc|json5|toml|yaml|yml|conf|cfg|ini|md|sh|bash|zsh|fish|lua|vim|rules)$/ || b ~ /rc$/ || b == "config"
    }
    { kind = $1; path = substr($0, length($1) + 2) }
    excluded(path) { next }
    kind == "config" && !config_like(path) { next }
    { print }' "$1"
}

# Keep small text files only (1 byte to DISCOVER_MAX_BYTES, no NUL bytes); large or
# binary files are data, not configuration. Batched: one stat call for sizes and one
# grep call listing files that contain a NUL (in the C locale, [^\x01-\xff] matches
# only that byte), joined by name, so a file that vanishes meanwhile is dropped.
keep_small_text_files() {
  : >"$2"
  test -s "$1" || return 0
  (cd "$DOTS_HOME" && tr '\n' '\0' <"$1" | xargs -0 stat -f "%z$TAB%N" 2>/dev/null) >"$2.sizes"
  (cd "$DOTS_HOME" && tr '\n' '\0' <"$1" | LC_ALL=C xargs -0 grep -l -a -e "$(printf '[^\001-\377]')" -- 2>/dev/null) >"$2.nul"
  awk -F '\t' -v max="$DISCOVER_MAX_BYTES" '
    FILENAME == ARGV[1] { if ($1 ~ /^[0-9]+$/) size[substr($0, length($1) + 2)] = $1 + 0; next }
    FILENAME == ARGV[2] { nul[$0] = 1; next }
    ($0 in size) && size[$0] > 0 && size[$0] <= max && !($0 in nul)' "$2.sizes" "$2.nul" "$1" >"$2"
  rm -f "$2.sizes" "$2.nul"
}

path_matches_list() {
  while IFS= read -r pm_pattern; do
    # shellcheck disable=SC2254 # rule patterns are globs on purpose
    case $1 in $pm_pattern) return 0 ;; esac
  done <"$2"
  return 1
}

# Rule patterns are HOME-relative printable ASCII globs without spaces or "..".
# A pattern naming a folder must spell out its first folder, which is where the
# include walk starts (".*/x" would otherwise mean the whole home folder).
valid_rule_pattern() {
  test -n "$1" || return 1
  local LC_ALL=C
  case $1 in *[!!-~]*) return 1 ;; esac
  case $1 in .*) ;; *) return 1 ;; esac
  case $1 in *'..'*|*'\\'*|*'//'*|*/) return 1 ;; esac
  case $1 in */*) case ${1%%/*} in *[*?[]*) return 1 ;; esac ;; esac
  return 0
}

# A file inside a Git checkout (other than HOME or ~/.config themselves) belongs to
# that project, not to this Mac's configuration.
inside_git_checkout() {
  gc_dir=${1%/*}
  while test "$gc_dir" != "$1" && test -n "$gc_dir"; do
    test "$gc_dir" = .config || { test ! -e "$DOTS_HOME/$gc_dir/.git" && test ! -L "$DOTS_HOME/$gc_dir/.git"; } || return 0
    case $gc_dir in */*) gc_dir=${gc_dir%/*} ;; *) break ;; esac
  done
  return 1
}

# Parse the optional rules file into include and exclude pattern lists.
# "include <pattern>" adds files the scan misses, "exclude <pattern>" drops files
# it finds; exclusions win, and the built-in exclusions always apply.
load_discover_rules() {
  : >"$1" && : >"$2" || return 1
  dr_file=$DOTS_HOME/$DISCOVER_RULES
  test -e "$dr_file" || test -L "$dr_file" || return 0
  { safe_live_path "$DISCOVER_RULES" && test -f "$dr_file" && test ! -L "$dr_file"; } || { say "$DISCOVER_RULES must be a regular file"; return 1; }
  dr_number=0
  while IFS= read -r dr_line || test -n "$dr_line"; do
    dr_number=$((dr_number + 1))
    case $dr_line in ''|'#'*) continue ;; esac
    dr_kind=${dr_line%% *}
    dr_pattern=${dr_line#* }
    if test "$dr_kind" != "$dr_line" && valid_rule_pattern "$dr_pattern"; then
      case $dr_kind in
        include) printf '%s\n' "$dr_pattern" >>"$1"; continue ;;
        exclude) printf '%s\n' "$dr_pattern" >>"$2"; continue ;;
      esac
    fi
    say "$DISCOVER_RULES line $dr_number: expected \"include <pattern>\" or \"exclude <pattern>\""
    return 1
  done <"$dr_file"
  return 0
}

# Checks that need the file system but no processes: a safe hidden manifest path,
# not dropped by an exclude rule, a regular file with no symlinked parent, outside
# the data directory, and outside Git checkouts unless an include rule named it.
check_candidates() {
  while IFS=$TAB read -r cc_kind cc_path; do
    case $cc_path in .*) ;; *) continue ;; esac
    valid_manifest_path "$cc_path" || continue
    path_matches_list "$cc_path" "$DC_EXCLUDES" && continue
    # A symlinked parent (for example ~/.claude -> elsewhere) would publish files from outside HOME.
    safe_live_path "$cc_path" || continue
    test -f "$DOTS_HOME/$cc_path" && test ! -L "$DOTS_HOME/$cc_path" && test -r "$DOTS_HOME/$cc_path" || continue
    is_reserved_path "$cc_path" && continue
    test "$cc_kind" = included || ! inside_git_checkout "$cc_path" || continue
    printf '%s\n' "$cc_path"
  done <"$1"
}

# Read NUL-delimited absolute paths and print "kind<TAB>relative path" lines, so a
# newline inside a filename cannot forge another path. An optional pattern keeps
# only matching paths.
raw_candidates() {
  while IFS= read -r -d '' rc_file; do
    rc_path=${rc_file#"$DOTS_HOME"/}
    # A tab would be stripped by the later tab-separated read, so the name checked
    # here and the file used there could differ. Valid paths never contain one.
    case $rc_path in *"$NL"*|*"$TAB"*) continue ;; esac
    if test -n "${2:-}"; then
      # shellcheck disable=SC2254 # rule patterns are globs on purpose
      case $rc_path in $2) ;; *) continue ;; esac
    fi
    printf '%s\t%s\n' "$1" "$rc_path"
  done
}

# Print files under a HOME-relative folder ("" for HOME itself), NUL-delimited so a
# newline inside a filename cannot forge another path; valid_manifest_path then
# rejects the control character. An optional second argument limits the depth.
walk_files() {
  if test -n "$1"; then
    safe_live_path "$1" && test -d "$DOTS_HOME/$1" && test ! -L "$DOTS_HOME/$1" || return 0
    wf_root=$DOTS_HOME/$1
  else
    wf_root=$DOTS_HOME
  fi
  if test -n "${2:-}"; then
    find "$wf_root" -mindepth 1 -maxdepth "$2" -type f -print0 2>/dev/null
  else
    find "$wf_root" -mindepth 1 -type f -print0 2>/dev/null
  fi
}

collect_candidates() {
  DC_APPROVED=$1
  DC_OUT=$2
  DC_INCLUDES=$2.includes
  DC_EXCLUDES=$2.excludes
  : >"$DC_OUT" && : >"$2.raw" || return 1
  load_discover_rules "$DC_INCLUDES" "$DC_EXCLUDES" || return 1
  {
    # Dotfiles directly in HOME, and everything under ~/.config.
    walk_files '' 1 | raw_candidates any
    walk_files .config | raw_candidates any
    # Config-like files up to two levels inside every other ~/.<name> folder.
    find "$DOTS_HOME" -mindepth 1 -maxdepth 1 -type d -name '.*' -print0 2>/dev/null | while IFS= read -r -d '' dc_dir; do
      dc_dir=${dc_dir#"$DOTS_HOME"/}
      case $dc_dir in .config|.local|.cache|.Trash|.npm|.cups|.git) continue ;; esac
      valid_manifest_path "$dc_dir" || continue
      is_reserved_path "$dc_dir" && continue
      walk_files "$dc_dir" 2 | raw_candidates config
    done
    # Rule includes: walk from the pattern's fixed leading folder, then match.
    while IFS= read -r dc_pattern; do
      dc_fixed=${dc_pattern%%[*?[]*}
      if test "$dc_fixed" = "$dc_pattern"; then printf 'included\t%s\n' "$dc_pattern"; continue; fi
      case $dc_fixed in */*) dc_base=${dc_fixed%/*}; dc_depth= ;; *) dc_base=; dc_depth=1 ;; esac
      walk_files "$dc_base" "$dc_depth" | raw_candidates included "$dc_pattern"
    done <"$DC_INCLUDES"
  } >"$2.raw" || return 1
  filter_candidate_names "$2.raw" >"$2.named" || return 1
  check_candidates "$2.named" | LC_ALL=C sort -u >"$2.checked" || return 1
  list_minus "$2.checked" "$DC_APPROVED" "$2.unapproved" || return 1
  keep_small_text_files "$2.unapproved" "$DC_OUT" || return 1
  rm -f "$DC_INCLUDES" "$DC_EXCLUDES" "$2.raw" "$2.named" "$2.checked" "$2.unapproved"
}

print_candidates() {
  candidates=$1
  count=$(wc -l <"$candidates" | tr -d ' ')
  test "$count" -gt 0 || { say "No unapproved, low-risk configuration candidates found."; return 0; }
  say "Candidate configuration files (names only):"
  awk '{ printf "%3d  %s\n", NR, $0 }' "$candidates"
}

# ── Checklist ───────────────────────────────────────────────
# Rows are "group<TAB>path[<TAB>note]" lines; manifest paths never contain whitespace. The chosen file holds the initial ticks and is
# rewritten with the final ticks. Returns 1 when the user cancels.
# Append one checklist page named $2 holding the paths in $1 (home files first).
# The optional file $4 holds "path<TAB>note" lines; a note is shown after the name.
labelled_rows() {
  test -s "$1" || return 0
  build_rows "$1" "$3.page"
  cut -f 2 "$3.page" | awk -v label="$2" -v notes="${4:-/dev/null}" '
    BEGIN { while ((getline line < notes) > 0) { i = index(line, "\t"); if (i) note[substr(line, 1, i - 1)] = substr(line, i + 1) } }
    { print label "\t" $0 (($0 in note) ? "\t" note[$0] : "") }' >>"$3"
  rm -f "$3.page"
}

build_rows() {
  # Home-folder files first, then one group per top-level directory.
  awk '{ i = index($0, "/"); if (i) print "1\t" substr($0, 1, i - 1) "\t" $0; else print "0\thome\t" $0 }' "$1" |
    LC_ALL=C sort -t "$TAB" -k1,1 -k2,2 -k3,3 | cut -f 2- >"$2"
}

list_toggle() {
  if path_in_list "$1" "$2"; then
    awk -v path="$1" '$0 != path' "$2" >"$2.next" && mv -f "$2.next" "$2"
  else
    printf '%s\n' "$1" >>"$2"
  fi
}

# Expand "1,3-5" into one number per line; fails on malformed or out-of-range input.
expand_numbers() {
  numbers=$1
  count=$2
  out=$3
  : >"$out"
  case $numbers in ,*|*,|*,,*|*[!0-9,-]*) return 1 ;; esac
  oldifs=$IFS
  IFS=,
  set -- $numbers
  IFS=$oldifs
  for item in "$@"; do
    case $item in
      *-*) start=${item%-*}; finish=${item#*-} ;;
      *) start=$item; finish=$item ;;
    esac
    test -n "$start" && test -n "$finish" && test "$start" -ge 1 2>/dev/null && test "$finish" -le "$count" 2>/dev/null && test "$start" -le "$finish" || return 1
    number=$start
    while test "$number" -le "$finish"; do
      path_in_list "$number" "$out" && return 1
      printf '%s\n' "$number" >>"$out"
      number=$((number + 1))
    done
  done
  return 0
}

checklist() {
  if test -t 0 && test -t 1 && test "${TERM:-dumb}" != dumb && test "${DOTS_PLAIN_PROMPTS:-0}" != 1; then
    checklist_tui "$@"
  else
    checklist_plain "$@"
  fi
}

checklist_plain() {
  cl_rows=$1
  cl_chosen=$2
  say "$3"
  number=0
  cl_groups=$(cut -f 1 "$cl_rows" | uniq | wc -l | tr -d ' ')
  cl_last=
  while IFS=$TAB read -r cl_group path cl_note; do
    if test "$cl_groups" -gt 1 && test "$cl_group" != "$cl_last"; then printf '%s:\n' "$cl_group"; cl_last=$cl_group; fi
    number=$((number + 1))
    if path_in_list "$path" "$cl_chosen"; then mark='[x]'; else mark='[ ]'; fi
    printf '%3d  %s %s%s\n' "$number" "$mark" "$path" "${cl_note:+  ($cl_note)}"
  done <"$cl_rows"
  printf 'Toggle numbers (for example 1,3-5), Enter to keep as shown: ' >&2
  IFS= read -r numbers || return 1
  test -n "$numbers" || return 0
  expand_numbers "$numbers" "$number" "$cl_chosen.numbers" || fail "selection must be numbers, commas, and ranges within the list"
  while IFS= read -r number; do
    path=$(sed -n "${number}p" "$cl_rows" | cut -f 2)
    list_toggle "$path" "$cl_chosen"
  done <"$cl_chosen.numbers"
  rm -f "$cl_chosen.numbers"
}

CL_ACTIVE=0
BACKUP_DIR=
checklist_stop() {
  test "$CL_ACTIVE" -eq 1 || return 0
  stty "$CL_STTY" <&3 >/dev/null 2>&1 || :
  printf '\033[?25h\033[?1049l' >&3 2>/dev/null || :
  exec 3>&-
  CL_ACTIVE=0
}

checklist_page_rows() { awk -F '\t' -v group="$CL_GROUP" '$1 == group { n++ } END { print n + 0 }' "$CL_ROWS"; }

checklist_current_path() {
  awk -F '\t' -v group="$CL_GROUP" -v wanted="$CL_CURSOR" '$1 == group { n++; if (n == wanted) { print $2; exit } }' "$CL_ROWS"
}

checklist_draw() {
  size=$(stty size <&3 2>/dev/null || printf '24 80')
  lines=${size%% *}
  columns=${size#* }
  case $lines in ''|*[!0-9]*) lines=24 ;; esac
  case $columns in ''|*[!0-9]*) columns=80 ;; esac
  width=$((columns - 1))
  CL_TOO_SMALL=0
  if test "$lines" -lt 8 || test "$columns" -lt 30; then
    CL_TOO_SMALL=1
    printf '\033[H\033[2J%s' 'Terminal too small. Enlarge it, or press q to cancel.' >&3
    return
  fi
  height=$((lines - 6))
  test "$CL_CURSOR" -ge "$CL_TOP" || CL_TOP=$CL_CURSOR
  test "$CL_CURSOR" -lt $((CL_TOP + height)) || CL_TOP=$((CL_CURSOR - height + 1))
  # One awk pass builds the whole frame, which is written over the previous one in a
  # single write. Clearing first, or a process per row, makes the list flicker.
  frame=$(awk -F '\t' -v group="$CL_GROUP" -v top="$CL_TOP" -v height="$height" -v cursor="$CL_CURSOR" -v width="$width" \
    -v title="$CL_TITLE" -v page="Page $CL_PAGE of $CL_PAGES: $CL_GROUP" \
    -v keys='Up/Down move  Left/Right page  Space toggle  a all  n none  Enter confirm  q cancel' '
    function out(text) { printf "%s\033[K\n", substr(text, 1, width) }
    FILENAME == ARGV[1] { chosen[$0] = 1; picked++; next }
    { total++ }
    $1 == group {
      row++
      if (row < top || shown >= height) next
      line = (row == cursor ? "> " : "  ") (($2 in chosen) ? "[x] " : "[ ] ") $2 (($3 != "") ? "  (" $3 ")" : "")
      body = body substr(line, 1, width) "\033[K\n"
      shown++
    }
    END {
      out(title); out(page); out(keys); out("")
      printf "%s", body
      printf "\033[K\n%s\033[K", substr((picked + 0) " of " (total + 0) " selected", 1, width)
    }' "$CL_CHOSEN" "$CL_ROWS")
  printf '\033[H%s\033[J' "$frame" >&3
}

checklist_set_page() {
  CL_GROUP=$(sed -n "${CL_PAGE}p" "$CL_GROUPS")
  CL_PAGE_ROWS=$(checklist_page_rows)
  CL_CURSOR=1
  CL_TOP=1
}

checklist_tui() {
  CL_ROWS=$1
  CL_CHOSEN=$2
  CL_TITLE=$3
  CL_GROUPS=$CL_CHOSEN.groups
  awk -F '\t' '!seen[$1]++ { print $1 }' "$CL_ROWS" >"$CL_GROUPS" || return 1
  CL_PAGES=$(list_count "$CL_GROUPS")
  test "$CL_PAGES" -gt 0 || return 0
  CL_PAGE=1
  checklist_set_page
  exec 3<>/dev/tty || return 1
  CL_STTY=$(stty -g <&3)
  CL_ACTIVE=1
  # Restore the terminal however the command ends.
  trap 'checklist_stop; rm -rf "$temp"' EXIT
  trap 'checklist_stop; rm -rf "$temp"; exit 130' HUP INT TERM
  stty -echo -icanon min 1 time 0 <&3
  printf '\033[?1049h\033[?25l\033[2J' >&3
  cl_status=0
  cl_escape=0
  while :; do
    checklist_draw
    IFS= read -r -s -n 1 key <&3 || { cl_status=1; break; }
    if test "$cl_escape" -eq 1; then
      cl_escape=0
      case $key in '['|O) cl_escape=2; continue ;; esac
    elif test "$cl_escape" -eq 2; then
      cl_escape=0
      case $key in A) key=k ;; B) key=j ;; C) key=l ;; D) key=h ;; *) continue ;; esac
    fi
    # Only cancelling works until the terminal is large enough to show the list.
    if test "$CL_TOO_SMALL" -eq 1; then test "$key" = q && { cl_status=1; break; }; continue; fi
    case $key in
      $'\033') cl_escape=1 ;;
      k) test "$CL_CURSOR" -le 1 || CL_CURSOR=$((CL_CURSOR - 1)) ;;
      j) test "$CL_CURSOR" -ge "$CL_PAGE_ROWS" || CL_CURSOR=$((CL_CURSOR + 1)) ;;
      h) test "$CL_PAGE" -le 1 || { CL_PAGE=$((CL_PAGE - 1)); checklist_set_page; } ;;
      l) test "$CL_PAGE" -ge "$CL_PAGES" || { CL_PAGE=$((CL_PAGE + 1)); checklist_set_page; } ;;
      ' ') path=$(checklist_current_path); test -z "$path" || list_toggle "$path" "$CL_CHOSEN" ;;
      a) awk -F '\t' -v group="$CL_GROUP" '$1 == group { print $2 }' "$CL_ROWS" | while IFS= read -r path; do path_in_list "$path" "$CL_CHOSEN" || printf '%s\n' "$path" >>"$CL_CHOSEN"; done ;;
      n) awk -F '\t' -v group="$CL_GROUP" '$1 == group { print $2 }' "$CL_ROWS" >"$CL_CHOSEN.page"; list_minus "$CL_CHOSEN" "$CL_CHOSEN.page" "$CL_CHOSEN.next"; mv -f "$CL_CHOSEN.next" "$CL_CHOSEN" ;;
      ''|$'\r'|$'\n') break ;;
      q) cl_status=1; break ;;
    esac
  done
  checklist_stop
  trap 'rm -rf "$temp"' EXIT HUP INT TERM
  rm -f "$CL_GROUPS" "$CL_CHOSEN.page"
  return "$cl_status"
}

# Copy live files into a new private backup directory, printing where they went.
backup_live_files() {
  paths=$1
  label=$2
  mkdir -p "$DOTS_DATA/backups" || return 1
  BACKUP_DIR=$(mktemp -d "$DOTS_DATA/backups/$label-$(date +%Y%m%d%H%M%S).XXXXXX") || return 1
  while IFS= read -r path; do
    mkdir -p "$BACKUP_DIR/$(dirname "$path")" && cp -p "$DOTS_HOME/$path" "$BACKUP_DIR/$path" || return 1
  done <"$paths"
  say "backed up $(list_count "$paths") existing file(s) to $BACKUP_DIR"
}

preview_candidates() {
  temp=$1
  : >"$temp/preview-approved"
  collect_candidates "$temp/preview-approved" "$temp/candidates" || fail "could not collect candidates"
  print_candidates "$temp/candidates"
  say "Preview only, no files, manifest, repository, or network state changed."
}

# Keep the current manifest's comments and order, drop removed paths, append added ones.
build_proposed_manifest() {
  current=$1
  removed=$2
  added=$3
  out=$4
  : >"$out" || return 1
  while IFS= read -r line || test -n "$line"; do
    case $line in ''|'#'*) printf '%s\n' "$line" >>"$out"; continue ;; esac
    path_in_list "$line" "$removed" || printf '%s\n' "$line" >>"$out"
  done <"$current"
  while IFS= read -r path; do
    path_in_list "$path" "$out" || printf '%s\n' "$path" >>"$out"
  done <"$added"
  validate_manifest_file "$out" "$out.validated"
}

configure_sandbox_identity() {
  sandbox=$1
  ensure_identity || return 1
  name=$(git_repo config --get user.name 2>/dev/null || true)
  email=$(git_repo config --get user.email 2>/dev/null || true)
  test -z "$name" || "$GIT" -C "$sandbox" config user.name "$name" || return 1
  test -z "$email" || "$GIT" -C "$sandbox" config user.email "$email" || return 1
}

prepare_local_sandbox() {
  sandbox=$1
  live_paths=$3
  all_paths=$4
  proposed_manifest=$5
  # Repository files this Mac does not use keep their repository version.
  unused=${6:-/dev/null}
  # Removals are staged by git rm; only copied files need adding afterwards.
  : >"$sandbox.copied"
  while IFS= read -r path; do
    if test "$path" = "$MANIFEST"; then
      mkdir -p "$sandbox/$(dirname "$path")" || return 1
      cp -p "$proposed_manifest" "$sandbox/$path" || return 1
      printf '%s\n' "$path" >>"$sandbox.copied"
    elif path_in_list "$path" "$unused"; then
      continue
    elif path_in_list "$path" "$live_paths"; then
      test -f "$DOTS_HOME/$path" && test ! -L "$DOTS_HOME/$path" || return 1
      mkdir -p "$sandbox/$(dirname "$path")" || return 1
      cp -p "$DOTS_HOME/$path" "$sandbox/$path" || return 1
      printf '%s\n' "$path" >>"$sandbox.copied"
    else
      "$GIT" -C "$sandbox" rm -f --quiet --ignore-unmatch -- "$path" >/dev/null || return 1
    fi
  done <"$all_paths"
  set --
  while IFS= read -r path; do set -- "$@" "$path"; done <"$sandbox.copied"
  rm -f "$sandbox.copied"
  "$GIT" -C "$sandbox" add -A -- "$@"
}

advance_to_remote_revision() {
  branch=$1
  remote=$2
  git_repo update-ref "refs/heads/$branch" "$remote" || return 1
  git_repo symbolic-ref HEAD "refs/heads/$branch" || return 1
  git_repo read-tree "$remote"
}

init_command() {
  if test "${1:-}" = --discover; then
    shift
    test $# -eq 0 || { usage >&2; exit 2; }
    temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
    preview_candidates "$temp"
    exit 0
  fi
  backup_existing=false
  if test "${1:-}" = --backup-existing; then backup_existing=true; shift; fi
  test $# -le 2 || { usage >&2; exit 2; }
  auto_default=false
  if test $# -eq 0 && test -e "$REPO"; then
    # Repeating init must not require gh merely to rediscover an existing remote.
    remote=$(git_repo remote get-url origin 2>/dev/null || true)
    test -n "$remote" || fail "existing repository has no origin remote"
    github_repository=
  elif test $# -eq 0; then
    auto_default=true
    if test -n "$DEFAULT_REMOTE" && test -n "$DEFAULT_GITHUB_REPO"; then
      remote=$DEFAULT_REMOTE
      github_repository=$DEFAULT_GITHUB_REPO
    else
      github_repository=$(github_repository_from_gh) || fail "GitHub CLI is unavailable, unauthenticated, or returned an unsafe account name"
      remote=https://github.com/$github_repository.git
      enable_gh_git_credentials
      private=$("$GH" repo view "$github_repository" --json isPrivate --jq .isPrivate 2>/dev/null || true)
      test -z "$private" -o "$private" = true || fail "default GitHub repository must be private"
    fi
  else
    remote=$1
    github_repository=
  fi
  requested_branch=${2:-}
  test -n "$requested_branch" && safe_branch "$requested_branch"
  require_dependencies
  if test -e "$REPO"; then
    ensure_initialized
    existing_remote=$(git_repo remote get-url origin 2>/dev/null || true)
    test "$existing_remote" = "$remote" || fail "already initialized with a different remote; use dots sync or remove the data directory deliberately"
    branch=$(current_branch)
    test -z "$requested_branch" -o "$requested_branch" = "$branch" || fail "already initialized with a different branch"
    temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
    validate_current_state "$temp" || fail "existing repository or live manifest is unsafe"
    say "already initialized on $branch; no live files changed"
    exit 0
  fi
  mkdir -p "$DOTS_DATA" || fail "cannot create data directory"
  temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
  candidate_repo=$temp/repo.git
  # The no-argument default is an account-derived private GitHub repository. For a
  # missing default, gh can create a minimal safe repository after confirmation.
  branch=${requested_branch:-main}
  safe_branch "$branch"
  created_default=false
  if ! "$GIT" clone --bare -- "$remote" "$candidate_repo" >/dev/null 2>&1; then
    test "$auto_default" = true || fail "could not clone remote"
    create_default_github_repository "$remote" "$github_repository" "$branch" "$temp"
    created_default=true
    "$GIT" clone --bare -- "$remote" "$candidate_repo" >/dev/null 2>&1 || fail "could not clone newly created remote"
  fi
  if test -z "$requested_branch" && test "$created_default" != true; then
    branch=$(git_dir "$candidate_repo" symbolic-ref --short HEAD 2>/dev/null || true)
    test -n "$branch" || fail "remote has no usable default branch; specify a branch"
    safe_branch "$branch"
  fi
  git_dir "$candidate_repo" fetch --no-tags origin "refs/heads/$branch:refs/heads/$branch" >/dev/null 2>&1 || fail "could not fetch requested branch"
  revision=$(git_dir "$candidate_repo" rev-parse "refs/heads/$branch" 2>/dev/null) || fail "requested branch has no revision"
  validate_tree "$candidate_repo" "$revision" "$temp/manifest-paths" "$temp" || fail "candidate manifest or repository tree is unsafe"
  scan_git_revision "$candidate_repo" "$revision" || scan_fail $? "nothing was changed on this Mac. The scan covers the repository's whole history, so remove the secret from every commit (or start from a clean repository), then run dots init again"
  # Choose which repository files this Mac uses. Without a terminal, all are used.
  cp "$temp/manifest-paths" "$temp/use" || fail "could not prepare file selection"
  if test -s "$temp/manifest-paths" && test -t 0 && test -t 1; then
    build_rows "$temp/manifest-paths" "$temp/rows"
    checklist "$temp/rows" "$temp/use" "Choose which files to bring to this Mac" || { say "init cancelled, nothing was changed"; exit 0; }
  fi
  list_minus "$temp/manifest-paths" "$temp/use" "$temp/skip"
  # Every chosen target, including the manifest, must be absent or already identical,
  # unless --backup-existing moves a differing regular file into a private backup first.
  list_with_manifest "$temp/use" "$temp/candidate-paths"
  : >"$temp/backup-paths"
  while IFS= read -r path; do
    safe_live_path "$path" || fail "candidate path has an unsafe live parent"
    test ! -e "$DOTS_HOME/$path" && test ! -L "$DOTS_HOME/$path" && continue
    test -f "$DOTS_HOME/$path" && test ! -L "$DOTS_HOME/$path" || fail "refusing to replace an existing live path that is not a regular file"
    git_dir "$candidate_repo" cat-file blob "$revision:$path" 2>/dev/null | cmp -s - "$DOTS_HOME/$path" && continue
    test "$backup_existing" = true || fail "refusing to overwrite an existing live file; rerun with --backup-existing to back it up and use the repository version"
    printf '%s\n' "$path" >>"$temp/backup-paths"
  done <"$temp/candidate-paths"
  backup_dir=
  if test -s "$temp/backup-paths"; then
    mkdir -p "$DOTS_DATA/backups" || fail "cannot create backup directory"
    backup_dir=$(mktemp -d "$DOTS_DATA/backups/init-$(date +%Y%m%d%H%M%S).XXXXXX") || fail "cannot create backup directory"
    while IFS= read -r path; do
      mkdir -p "$backup_dir/$(dirname "$path")" && cp -p "$DOTS_HOME/$path" "$backup_dir/$path" || fail "could not back up existing live files; nothing was replaced (partial backup: $backup_dir)"
    done <"$temp/backup-paths"
    say "backed up $(wc -l <"$temp/backup-paths" | tr -d ' ') existing file(s) to $backup_dir"
    # A file edited after its backup would lose that edit, so re-check just before replacing.
    while IFS= read -r path; do
      cmp -s "$backup_dir/$path" "$DOTS_HOME/$path" || fail "an existing live file changed during init; nothing was replaced (backup: $backup_dir)"
    done <"$temp/backup-paths"
  fi
  backup_note=
  test -z "$backup_dir" || backup_note=" (backup: $backup_dir)"
  mv "$candidate_repo" "$REPO" || fail "could not install repository metadata"
  # From here a failure removes the incomplete repository so init can be retried.
  init_abort() { rm -rf "$REPO"; fail "$1$backup_note"; }
  git_repo config status.showUntrackedFiles no || init_abort "could not configure repository"
  git_repo config dots.branch "$branch" || init_abort "could not record branch"
  git_repo update-ref "refs/heads/$branch" "$revision" || init_abort "could not set requested branch"
  git_repo symbolic-ref HEAD "refs/heads/$branch" || init_abort "could not select requested branch"
  # Checkout only validated, explicit paths. This is never a broad checkout.
  set --
  while IFS= read -r path; do set -- "$@" "$path"; done <"$temp/candidate-paths"
  git_repo checkout --quiet "$revision" -- "$@" || init_abort "checkout failed after preflight; inspect live files before retrying"
  # The index records every repository file; only chosen ones exist in HOME.
  git_repo read-tree "$revision" || init_abort "could not record the repository index"
  write_selection "$temp/use" "$temp/skip" "$temp/manifest-paths" || init_abort "could not save the file selection"
  git_repo config dots.initialized true || init_abort "could not finalize initialization"
  skipped=$(list_count "$temp/skip")
  test "$skipped" -eq 0 || say "not using $skipped repository file(s) on this Mac; change with: dots select"
  say "initialized $branch at $revision"
}

# ── Catching up ─────────────────────────────────────────────
# Each file is compared three ways: on this Mac, at the revision this Mac last synced
# (base), and in the repository (remote). A state is "<mode> <blob>", or "-" when the
# file is absent; only Git's mode (executable bit) and content count.

# $1 path list, $2 output of "state<TAB>path" lines for this Mac's files.
live_states() {
  : >"$2.present" && : >"$2.modes" || return 1
  while IFS= read -r ls_path; do
    ls_file=$DOTS_HOME/$ls_path
    if test -L "$ls_file"; then return 1
    elif test -f "$ls_file"; then
      printf '%s\n' "$ls_path" >>"$2.present"
      if test -x "$ls_file"; then printf '100755\n'; else printf '100644\n'; fi >>"$2.modes"
    elif test -e "$ls_file"; then return 1
    fi
  done <"$1"
  : >"$2.blobs"
  if test -s "$2.present"; then git_repo hash-object --no-filters --stdin-paths <"$2.present" >"$2.blobs" || return 1; fi
  test "$(list_count "$2.present")" = "$(list_count "$2.blobs")" || return 1
  paste -d ' ' "$2.modes" "$2.blobs" | paste -d "$TAB" - "$2.present" >"$2.known"
  awk -F '\t' 'FILENAME == ARGV[1] { state[$2] = $1; next } { print (($0 in state) ? state[$0] : "-") "\t" $0 }' "$2.known" "$1" >"$2"
  rm -f "$2.present" "$2.modes" "$2.blobs" "$2.known"
}

# $1 revision, $2 output of "state<TAB>path" lines for every file in it.
tree_states() {
  # Validated trees hold no names with newlines, so NUL-separated output can become
  # lines without Git's quoting.
  git_repo ls-tree -r -z "$1" | tr '\0' '\n' >"$2.raw" || return 1
  awk -F '\t' '{ split($1, meta, " "); print meta[1] " " meta[3] "\t" $2 }' "$2.raw" >"$2"
  rm -f "$2.raw"
}

# classify base remote paths dir: writes dir/{same,incoming,local,clash} path lists,
# dir/live (this Mac's states, for re-checking later), and dir/states
# ("live<TAB>base<TAB>remote<TAB>path").
classify_paths() {
  mkdir -p "$4" || return 1
  live_states "$3" "$4/live" || return 1
  tree_states "$1" "$4/base" || return 1
  tree_states "$2" "$4/remote" || return 1
  awk -F '\t' -v dir="$4" '
    FILENAME == ARGV[1] { b[$2] = $1; next }
    FILENAME == ARGV[2] { r[$2] = $1; next }
    {
      l = $1; p = $2
      bs = (p in b) ? b[p] : "-"; rs = (p in r) ? r[p] : "-"
      if (l == rs) c = "same"; else if (l == bs) c = "incoming"; else if (rs == bs) c = "local"; else c = "clash"
      print p > (dir "/" c)
      print l "\t" bs "\t" rs "\t" p > (dir "/states")
    }' "$4/base" "$4/remote" "$4/live" || return 1
  for cp_kind in same incoming local clash states; do test -f "$4/$cp_kind" || : >"$4/$cp_kind"; done
}

# The manifest is merged rather than asked about: the repository's lines, minus the
# ones removed here, plus the ones added here. $1 base list, $2 live list,
# $3 remote manifest file, $4 output.
merge_manifest() {
  list_minus "$1" "$2" "$4.removed" && list_minus "$2" "$1" "$4.added" || return 1
  awk 'FILENAME == ARGV[1] { removed[$0] = 1; next } !($0 in removed) { print }' "$4.removed" "$3" >"$4" || return 1
  awk 'FILENAME == ARGV[1] { seen[$0] = 1; next } !($0 in seen)' "$4" "$4.added" >>"$4" || return 1
  rm -f "$4.removed" "$4.added"
}

clash_reason() {
  case $1 in -) printf '%s' "deleted here, changed in the repository"; return ;; esac
  case $2 in -) printf '%s' "your copy differs from the one in the repository"; return ;; esac
  printf '%s' "changed both here and in the repository"
}

# catch_up temp base remote branch ask|refuse
# Brings this Mac to the remote revision: files not edited here take the repository's
# version, edits the repository did not touch are kept, and files changed on both
# sides are asked about one by one (or, with "refuse", reported). Uses temp lists
# use, skip, pending, remote-manifest, head-manifest, live-manifest; writes the
# selection. Leaves temp/cu/{brought,kept-edits} for the summary.
catch_up() {
  cu=$1/cu
  list_intersect "$1/remote-manifest" "$1/use" "$1/cu-used"
  validate_live_paths "$1/cu-used" || fail "a file this Mac uses has an unsafe path on disk; nothing was changed"
  list_with_manifest "$1/cu-used" "$1/cu-paths"
  classify_paths "$2" "$3" "$1/cu-paths" "$cu" || fail "could not compare files with the repository; nothing was changed"
  # The manifest is merged, never asked about.
  manifest_merge=false
  if path_in_list "$MANIFEST" "$cu/clash"; then
    manifest_merge=true
    printf '%s\n' "$MANIFEST" >"$1/cu-manifest-only"
    list_minus "$cu/clash" "$1/cu-manifest-only" "$cu/clash.next" && mv -f "$cu/clash.next" "$cu/clash"
  fi
  : >"$cu/take" && : >"$cu/keep"
  if test -s "$cu/clash"; then
    if test "$5" = refuse; then
      say "These files changed both here and in the repository:" >&2
      sed 's/^/  /' "$cu/clash" >&2
      fail "run dots sync to choose which version to keep, then dots update"
    fi
    say "Some files changed both here and in the repository since this Mac last synced."
    # Answers come from the terminal on fd 4; the loop itself reads the file list.
    exec 4<&0
    while IFS= read -r cu_path; do
      cu_state=$(awk -F '\t' -v p="$cu_path" '$4 == p { print $1 "\t" $2; exit }' "$cu/states")
      say ""
      say "$cu_path: $(clash_reason "${cu_state%%"$TAB"*}" "${cu_state#*"$TAB"}")"
      say "  1. Use the repository's version (yours is backed up first)"
      say "  2. Keep yours (send it with dots update if it should replace the repository's)"
      while :; do
        printf 'Choose [1-2]: ' >&2
        IFS= read -r cu_choice <&4 || fail "sync cancelled, nothing was changed"
        case $cu_choice in
          1) printf '%s\n' "$cu_path" >>"$cu/take"; break ;;
          2) printf '%s\n' "$cu_path" >>"$cu/keep"; break ;;
          *) say "type 1 or 2" ;;
        esac
      done
    done <"$cu/clash"
    exec 4<&-
  fi
  # What will be written, and what is backed up first.
  cat "$cu/incoming" "$cu/take" >"$cu/write"
  : >"$cu/backup"
  while IFS= read -r cu_path; do
    test -e "$DOTS_HOME/$cu_path" && printf '%s\n' "$cu_path" >>"$cu/backup"
  done <"$cu/take"
  if test "$manifest_merge" = true; then
    git_repo cat-file blob "$3:$MANIFEST" >"$1/cu-remote-manifest" || fail "could not read the repository manifest"
    merge_manifest "$1/head-manifest" "$1/live-manifest" "$1/cu-remote-manifest" "$1/cu-merged-manifest" || fail "could not merge the manifest"
    validate_manifest_file "$1/cu-merged-manifest" "$1/cu-merged-list" || fail "the merged manifest is unsafe; nothing was changed"
    printf '%s\n' "$MANIFEST" >>"$cu/backup"
  fi
  if test -s "$cu/backup"; then backup_live_files "$cu/backup" sync || fail "could not back up local files; nothing was changed"; fi
  # Each file is re-checked (safe path, same state as when it was compared) right
  # before it is written, so an edit made meanwhile is not overwritten. Existing
  # files keep their permissions apart from the executable bit; new ones are private.
  mkdir -p "$1/cu-files" || return 1
  test "$manifest_merge" = false || printf '%s\n' "$MANIFEST" >>"$cu/write"
  : >"$cu/written"
  while IFS= read -r cu_path; do
    mkdir -p "$1/cu-files/$(dirname "$cu_path")" || return 1
    if test "$cu_path" = "$MANIFEST" && test "$manifest_merge" = true; then
      cp "$1/cu-merged-manifest" "$1/cu-files/$cu_path" || return 1
      cu_exec=no
    else
      git_repo cat-file blob "$3:$cu_path" >"$1/cu-files/$cu_path" || return 1
      case $(awk -F '\t' -v p="$cu_path" '$4 == p { print $3; exit }' "$cu/states") in 100755*) cu_exec=yes ;; *) cu_exec=no ;; esac
    fi
    safe_live_path "$cu_path" || return 1
    mkdir -p "$DOTS_HOME/$(dirname "$cu_path")" || return 1
    printf '%s\n' "$cu_path" >"$cu/one"
    live_states "$cu/one" "$cu/one-now" || return 1
    awk -F '\t' 'FILENAME == ARGV[1] { was[$2] = $1; next } was[$2] != $1 { bad = 1 } END { exit bad }' "$cu/live" "$cu/one-now" || return 1
    safe_live_path "$cu_path" || return 1
    cp "$1/cu-files/$cu_path" "$DOTS_HOME/$cu_path" || return 1
    if test "$cu_exec" = yes; then chmod u+x "$DOTS_HOME/$cu_path"; else chmod a-x "$DOTS_HOME/$cu_path"; fi || return 1
    printf '%s\n' "$cu_path" >>"$cu/written"
  done <"$cu/write"
  advance_to_remote_revision "$4" "$3" || return 1
  write_selection "$1/use" "$1/skip" "$1/remote-manifest" "$1/pending" || return 1
  grep -v -x -F -- "$MANIFEST" "$cu/written" >"$cu/brought" || : >"$cu/brought"
  cat "$cu/local" "$cu/keep" | grep -v -x -F -- "$MANIFEST" >"$cu/kept-edits" || : >"$cu/kept-edits"
}

# Stop after a failed catch-up, saying what was already written.
catch_up_failed() {
  if test -s "$1/cu/written"; then
    say "already updated from the repository before stopping:" >&2
    sed 's/^/  /' "$1/cu/written" >&2
  fi
  fail "could not finish catching up (a file changed meanwhile, or a write failed); run dots sync again${BACKUP_DIR:+. Backup: $BACKUP_DIR}"
}

# Print what catching up did, and edits that are still only on this Mac.
report_catch_up() {
  test ! -s "$1/cu/brought" || { say "brought in from the repository:"; sed 's/^/  /' "$1/cu/brought"; }
  list_intersect "$1/head-manifest" "$1/use" "$1/cu-was-used"
  list_minus "$1/cu-was-used" "$1/remote-manifest" "$1/cu-dropped"
  test ! -s "$1/cu-dropped" || { say "no longer shared by the repository (kept on this Mac):"; sed 's/^/  /' "$1/cu-dropped"; }
}

report_local_edits() {
  if test -s "$1"; then
    say "edited here, not in the repository yet:"
    sed 's/^/  /' "$1"
    say "run dots update to send them"
  fi
}

status_command() {
  test $# -eq 0 || { usage >&2; exit 2; }
  require_dependencies
  ensure_initialized
  temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
  validate_current_state "$temp" || fail "repository tree or live manifest is unsafe"
  branch=$(current_branch)
  head=$(head_revision) || fail "cannot resolve current revision"
  fetch_origin "$branch" || fail "could not reach the repository (check your network and gh auth status)"
  remote=$(git_repo rev-parse "refs/remotes/origin/$branch" 2>/dev/null) || fail "remote branch is unavailable"
  validate_tree "$REPO" "$remote" "$temp/remote-manifest" "$temp" || fail "the repository has unsafe changes; dots sync will refuse them"
  behind=$(git_repo rev-list --count "$head..$remote" 2>/dev/null) || fail "cannot compare with the repository"
  say "branch: $branch"
  if test "$behind" -eq 0; then say "this Mac: up to date"; else say "this Mac: $behind repository update(s) not synced yet (run dots sync)"; fi
  say "files used on this Mac: $(list_count "$temp/selected-manifest") of $(list_count "$temp/manifest-union")"
  # The files sync would look at (the repository's files this Mac uses, files added
  # to the manifest here, and the manifest), compared three ways.
  list_intersect "$temp/remote-manifest" "$temp/use" "$temp/remote-used"
  list_union "$temp/remote-used" "$temp/hand-added" "$temp/status-used"
  list_with_manifest "$temp/status-used" "$temp/status-paths"
  classify_paths "$head" "$remote" "$temp/status-paths" "$temp/st" || fail "could not compare files with the repository"
  # The manifest is combined by sync, never asked about.
  if path_in_list "$MANIFEST" "$temp/st/clash"; then
    printf '%s\n' "$MANIFEST" >"$temp/st/manifest-only"
    list_minus "$temp/st/clash" "$temp/st/manifest-only" "$temp/st/clash.next" && mv -f "$temp/st/clash.next" "$temp/st/clash"
    printf '%s\n' "$MANIFEST" >>"$temp/st/local"
  fi
  if test -s "$temp/st/local"; then say "edited here, not in the repository yet:"; sed 's/^/  /' "$temp/st/local"; else say "edits here: none"; fi
  test ! -s "$temp/st/incoming" || { say "changed in the repository, not here yet:"; sed 's/^/  /' "$temp/st/incoming"; }
  test ! -s "$temp/st/clash" || { say "changed both here and in the repository (dots sync will ask):"; sed 's/^/  /' "$temp/st/clash"; }
  list_intersect "$temp/head-manifest" "$temp/use" "$temp/st-was-used"
  list_minus "$temp/st-was-used" "$temp/remote-manifest" "$temp/st-dropped"
  test ! -s "$temp/st-dropped" || { say "no longer shared by the repository (dots sync keeps them on this Mac):"; sed 's/^/  /' "$temp/st-dropped"; }
  list_minus "$temp/remote-manifest" "$temp/use" "$temp/st-unseen-all"
  list_minus "$temp/st-unseen-all" "$temp/skip" "$temp/st-unseen"
  test ! -s "$temp/st-unseen" || { say "new in the repository (dots sync will ask whether to use them here):"; sed 's/^/  /' "$temp/st-unseen"; }
}

fetch_validated_remote() {
  temp=$1
  branch=$2
  fetch_origin "$branch" || return 1
  remote=$(git_repo rev-parse "refs/remotes/origin/$branch" 2>/dev/null) || return 1
  validate_tree "$REPO" "$remote" "$temp/remote-manifest" "$temp" || return 1
  scan_git_revision "$REPO" "$remote" || return 1
  printf '%s\n' "$remote"
}

# An unfinished merge from dots 0.2.2 or earlier; merging was removed.
refuse_old_conflict_workspace() {
  test ! -e "$DOTS_DATA/conflict-workspace" ||
    fail "an unfinished merge from an older dots version is in $DOTS_DATA/conflict-workspace. Copy anything you need from it, delete the folder, then run dots sync again"
}

sync_command() {
  if test "${1:-}" = --continue; then
    fail "merging was removed: run dots sync, which asks about each file changed both here and in the repository"
  fi
  test $# -eq 0 || { usage >&2; exit 2; }
  require_dependencies
  ensure_initialized
  test -t 0 && test -t 1 || fail "sync requires an interactive terminal"
  refuse_old_conflict_workspace
  temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
  validate_current_state "$temp" || fail "repository tree or live manifest is unsafe"
  git_repo diff --cached --quiet || fail "repository index has staged changes; resolve or unstage them before sync"
  scan_live_candidates "$temp/selected-paths" "$temp" || scan_fail $? "nothing was changed. Remove the secret from the local file, then run dots sync again"
  branch=$(current_branch)
  base=$(head_revision) || fail "cannot resolve current revision"
  remote=$(fetch_validated_remote "$temp" "$branch") || fail "incoming repository data is unsafe or unavailable"
  git_repo merge-base --is-ancestor "$base" "$remote" || test "$base" = "$remote" || fail "remote history is not a safe fast-forward"
  # This Mac's own merged update PRs: its pending files are used here, not offered.
  pending_arrived "$temp" "$temp/remote-manifest"
  # Files another Mac added that this Mac has not been asked about yet. The choice is
  # saved only when the Mac catches up.
  list_minus "$temp/remote-manifest" "$temp/use" "$temp/unseen-used"
  list_minus "$temp/unseen-used" "$temp/skip" "$temp/unseen"
  if test -s "$temp/unseen"; then
    build_rows "$temp/unseen" "$temp/unseen-rows"
    cp "$temp/unseen" "$temp/unseen-chosen"
    checklist "$temp/unseen-rows" "$temp/unseen-chosen" "New files in the repository: choose which to use on this Mac" || fail "sync cancelled, nothing was changed"
    list_minus "$temp/unseen" "$temp/unseen-chosen" "$temp/newly-skipped"
    cat "$temp/unseen-chosen" >>"$temp/use"
    cat "$temp/newly-skipped" >>"$temp/skip"
  fi
  catch_up "$temp" "$base" "$remote" "$branch" ask || catch_up_failed "$temp"
  report_catch_up "$temp"
  if test "$base" = "$remote" && ! test -s "$temp/cu/brought"; then say "this Mac is up to date"; else say "this Mac is now up to date"; fi
  report_local_edits "$temp/cu/kept-edits"
}

OPEN_UPDATE_PRS_JQ='.[] | select(.headRefName | startswith("dots/update-")) | .url'
open_update_prs() {
  "$GH" pr list --repo "$1" --state open --json headRefName,url --jq "$OPEN_UPDATE_PRS_JQ" </dev/null 2>/dev/null
}

report_open_update_prs() {
  test -z "$1" || fail "an earlier update PR is still open: $(printf '%s\n' "$1" | head -1). Merge or close it, run dots sync, then try again"
}

refuse_open_update_pr() {
  open_prs=$(open_update_prs "$1") || fail "could not check for open update PRs"
  report_open_update_prs "$open_prs"
}

update_command() {
  test $# -eq 0 || { usage >&2; exit 2; }
  require_dependencies
  require_tool "$GH"
  ensure_initialized
  test -t 0 && test -t 1 || fail "update requires an interactive terminal"
  temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
  origin=$(git_repo remote get-url origin 2>/dev/null || true)
  case $origin in
    https://github.com/*/*.git) repo_name=${origin#https://github.com/}; repo_name=${repo_name%.git} ;;
    git@github.com:*/*.git) repo_name=${origin#git@github.com:}; repo_name=${repo_name%.git} ;;
    *) fail "update PRs require a GitHub origin remote" ;;
  esac
  safe_github_component "${repo_name%%/*}" && safe_github_component "${repo_name##*/}" || fail "origin is not an accessible GitHub repository"
  # The GitHub checks run in the background while the repository is fetched and
  # validated; their results are required before anything is shown or written.
  "$GH" repo view "$repo_name" --json nameWithOwner </dev/null >/dev/null 2>&1 &
  gh_view=$!
  # Started directly rather than through a function, so each job's PID is gh itself.
  "$GH" pr list --repo "$repo_name" --state open --json headRefName,url --jq "$OPEN_UPDATE_PRS_JQ" </dev/null >"$temp/open-prs" 2>/dev/null &
  gh_prs=$!
  # Any early failure stops them rather than leaving them running.
  trap 'kill "$gh_view" "$gh_prs" 2>/dev/null; rm -rf "$temp"' EXIT HUP INT TERM
  validate_current_state "$temp" || fail "repository tree or live manifest is unsafe"
  branch=$(current_branch)
  base=$(head_revision) || fail "cannot resolve current revision"
  remote=$(fetch_validated_remote "$temp" "$branch") || fail "incoming repository data is unsafe or unavailable"
  if ! wait "$gh_view"; then
    "$GH" auth status </dev/null >/dev/null 2>&1 || fail "GitHub CLI is not authenticated"
    fail "origin is not an accessible GitHub repository"
  fi
  # One update PR at a time: a second one would conflict on the manifest.
  wait "$gh_prs" || fail "could not check for open update PRs"
  trap 'rm -rf "$temp"' EXIT HUP INT TERM
  report_open_update_prs "$(cat "$temp/open-prs")"
  # A PR is built on the latest revision, so catch up first (as sync would, without
  # questions), then look at this Mac again.
  if test "$base" != "$remote"; then
    refuse_old_conflict_workspace
    git_repo diff --cached --quiet || fail "repository index has staged changes; resolve or unstage them first"
    git_repo merge-base --is-ancestor "$base" "$remote" || fail "remote history is not a safe fast-forward"
    pending_arrived "$temp" "$temp/remote-manifest"
    catch_up "$temp" "$base" "$remote" "$branch" refuse || catch_up_failed "$temp"
    report_catch_up "$temp"
    list_minus "$temp/remote-manifest" "$temp/use" "$temp/unseen-used"
    list_minus "$temp/unseen-used" "$temp/skip" "$temp/unseen"
    test ! -s "$temp/unseen" || say "new files in the repository: run dots sync to choose whether to use them here"
    validate_current_state "$temp" || fail "repository tree or live manifest is unsafe"
    base=$(head_revision) || fail "cannot resolve current revision"
    test "$base" = "$remote" || fail "could not catch up with the repository"
  fi
  collect_candidates "$temp/live-manifest" "$temp/candidates" || fail "could not collect candidates"
  # Ticked rows are shared from this Mac; new candidates start unticked unless an
  # earlier update already chose them (pending). Candidates left unticked before are
  # listed last, under "previously ignored".
  list_intersect "$temp/live-manifest" "$temp/use" "$temp/shared"
  list_intersect "$temp/candidates" "$temp/ignore" "$temp/ignored-candidates"
  list_minus "$temp/candidates" "$temp/ignore" "$temp/fresh-candidates"
  list_intersect "$temp/candidates" "$temp/pending" "$temp/pending-ticked"
  list_union "$temp/shared" "$temp/pending-ticked" "$temp/chosen"
  # Shared files whose content or executable bit differs from the last sync, and
  # which of those were deleted here.
  set --
  while IFS= read -r path; do set -- "$@" "$path"; done <"$temp/shared"
  : >"$temp/changed"
  if test $# -gt 0; then
    git_repo diff --name-only -z HEAD -- "$@" 2>/dev/null | tr '\0' '\n' >"$temp/changed" || : >"$temp/changed"
  fi
  : >"$temp/missing"
  : >"$temp/notes"
  while IFS= read -r path; do
    if test -e "$DOTS_HOME/$path" || test -L "$DOTS_HOME/$path"; then
      printf '%s\tchanged\n' "$path" >>"$temp/notes"
    else
      printf '%s\n' "$path" >>"$temp/missing"
      printf '%s\tdeleted here\n' "$path" >>"$temp/notes"
    fi
  done <"$temp/changed"
  list_minus "$temp/shared" "$temp/changed" "$temp/unchanged"
  # One page each, in this order, skipping empty ones. Page names say what a tick
  # means: edits to send, files to start sharing, files to keep sharing.
  : >"$temp/rows"
  labelled_rows "$temp/changed" "edits to send (untick to leave an edit out of this PR)" "$temp/rows" "$temp/notes"
  labelled_rows "$temp/fresh-candidates" "new files (tick to start sharing)" "$temp/rows"
  labelled_rows "$temp/unchanged" "shared files (untick to stop sharing on every Mac)" "$temp/rows"
  labelled_rows "$temp/ignored-candidates" "previously ignored (tick to start sharing)" "$temp/rows"
  if test -s "$temp/rows"; then
    checklist "$temp/rows" "$temp/chosen" "Choose what this update sends to the repository" || fail "update cancelled, nothing was changed"
  fi
  list_intersect "$temp/chosen" "$temp/candidates" "$temp/added"
  # Unticked unchanged files stop being shared; a ticked deletion removes the file.
  list_minus "$temp/unchanged" "$temp/chosen" "$temp/removed"
  list_intersect "$temp/missing" "$temp/chosen" "$temp/deleted-sent"
  cat "$temp/deleted-sent" >>"$temp/removed"
  # Unticked edits keep the repository version in this PR; the local file is kept.
  list_minus "$temp/changed" "$temp/chosen" "$temp/held"
  if test -s "$temp/added" || test -s "$temp/removed"; then
    test ! -s "$temp/added" || { say "Start sharing:"; sed 's/^/  /' "$temp/added"; }
    test ! -s "$temp/removed" || { say "Stop sharing on every Mac (files on this Mac are kept):"; sed 's/^/  /' "$temp/removed"; }
    printf 'Continue? [y/N] ' >&2
    IFS= read -r answer || fail "update cancelled"
    case $answer in
      y|Y|yes|YES) confirmed=true ;;
      *)
        confirmed=false
        # A declined deletion is held like any unticked edit: the repository keeps the file.
        cat "$temp/deleted-sent" >>"$temp/held"
        : >"$temp/added"; : >"$temp/removed"; say "no files added or removed" ;;
    esac
  else
    confirmed=true
  fi
  if test "$confirmed" = true; then
    # Pending entries not offered in this checklist (for example a file deleted since) are kept.
    list_minus "$temp/pending" "$temp/candidates" "$temp/pending-unoffered"
    list_union "$temp/added" "$temp/pending-unoffered" "$temp/pending-after"
    # Unticked candidates are remembered as ignored; entries not offered this time are kept.
    list_minus "$temp/candidates" "$temp/chosen" "$temp/ignore-now"
    list_minus "$temp/ignore" "$temp/candidates" "$temp/ignore-unoffered"
    list_union "$temp/ignore-now" "$temp/ignore-unoffered" "$temp/ignore-after"
    write_selection "$temp/use" "$temp/skip" "$temp/manifest-union" "$temp/pending-after" "$temp/ignore-after" || fail "could not save the file selection"
  fi
  build_proposed_manifest "$DOTS_HOME/$MANIFEST" "$temp/removed" "$temp/added" "$temp/proposed-manifest" || fail "could not build proposed manifest"
  validate_manifest_file "$temp/proposed-manifest" "$temp/proposed-list" || fail "proposed manifest is unsafe"
  # Only files this Mac uses are read from HOME; the rest keep their repository version.
  list_union "$temp/use" "$temp/added" "$temp/used-after"
  list_intersect "$temp/proposed-list" "$temp/used-after" "$temp/proposed-used-all"
  list_minus "$temp/proposed-used-all" "$temp/held" "$temp/proposed-used"
  list_minus "$temp/proposed-list" "$temp/proposed-used" "$temp/proposed-unused"
  validate_live_paths "$temp/proposed-used" || fail "proposed manifest names an unsafe live path"
  list_with_manifest "$temp/proposed-list" "$temp/proposed-paths"
  list_with_manifest "$temp/proposed-used" "$temp/scan-paths"
  : >"$temp/update-paths"
  append_unique_list "$temp/head-paths" "$temp/update-paths"
  append_unique_list "$temp/proposed-paths" "$temp/update-paths"
  scan_live_candidates "$temp/scan-paths" "$temp" || scan_fail $? "nothing was pushed. Remove the secret from the file, or untick the file, then run dots update again"
  update_workspace=$temp/update-workspace
  "$GIT" clone --quiet --no-checkout -- "$REPO" "$update_workspace" || fail "could not prepare update workspace"
  "$GIT" -C "$update_workspace" checkout --quiet "$base" || fail "could not prepare update base"
  configure_sandbox_identity "$update_workspace" || fail "Git author identity is required for an update PR"
  prepare_local_sandbox "$update_workspace" "$temp/head-paths" "$temp/proposed-paths" "$temp/update-paths" "$temp/proposed-manifest" "$temp/proposed-unused" || fail "could not prepare local update"
  "$GIT" -C "$update_workspace" diff --cached --quiet && { say "nothing to send"; return; }
  say "Changes in this PR:"
  "$GIT" -C "$update_workspace" diff --cached --name-status -z --no-renames | while IFS= read -r -d '' us_status && IFS= read -r -d '' us_path; do
    case $us_status in A) us_word=added ;; D) us_word=removed ;; *) us_word=changed ;; esac
    valid_manifest_path "$us_path" || us_path='(a file with an unusual name)'
    printf '  %-8s %s\n' "$us_word" "$us_path"
  done
  printf 'PR title: ' >&2
  IFS= read -r title || fail "PR title cancelled"
  test -n "$title" || fail "PR title is required"
  update_branch=dots/update-$(date +%Y%m%d%H%M%S)
  "$GIT" -C "$update_workspace" checkout -qb "$update_branch" || fail "could not create update branch"
  "$GIT" -C "$update_workspace" commit --quiet -m "$title" || fail "could not create update commit"
  tree=$("$GIT" -C "$update_workspace" rev-parse 'HEAD^{tree}') || fail "could not read update tree"
  validate_tree "$update_workspace/.git" "$tree" "$temp/update-manifest" "$temp" || fail "update tree is unsafe"
  scan_directory "$update_workspace" || scan_fail $? "nothing was pushed. Remove the secret from the file, or untick the file, then run dots update again"
  enable_gh_git_credentials
  # Checked again here, in case another Mac opened one while this checklist was open.
  refuse_open_update_pr "$repo_name"
  # Push to the GitHub remote itself: "origin" in this temporary clone is the local data repository.
  "$GIT" -C "$update_workspace" push --quiet "$origin" "$update_branch" || fail "could not push update branch"
  "$GH" pr create --repo "$repo_name" --base "$branch" --head "$update_branch" --title "$title" --body "Created by dots update." || fail "branch was pushed but PR creation failed"
  say "update PR created"
  say "after merging it on GitHub, run: dots sync"
}

select_command() {
  test $# -eq 0 || { usage >&2; exit 2; }
  require_dependencies
  ensure_initialized
  test -t 0 && test -t 1 || fail "select requires an interactive terminal"
  temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
  validate_current_state "$temp" || fail "repository tree or live manifest is unsafe"
  test -s "$temp/head-manifest" || { say "the repository has no files yet; add some with: dots update"; return 0; }
  list_intersect "$temp/head-manifest" "$temp/use" "$temp/chosen"
  cp "$temp/chosen" "$temp/before" || fail "could not prepare file selection"
  build_rows "$temp/head-manifest" "$temp/rows"
  checklist "$temp/rows" "$temp/chosen" "Choose which repository files this Mac uses" || { say "selection unchanged"; return 0; }
  list_minus "$temp/chosen" "$temp/before" "$temp/newly-used"
  list_minus "$temp/head-manifest" "$temp/chosen" "$temp/skip"
  head=$(head_revision) || fail "cannot resolve current revision"
  # Newly chosen files come from the current repository revision. Identical or absent
  # live files are fine; differing ones are backed up after confirmation.
  : >"$temp/backup-paths"
  while IFS= read -r path; do
    safe_live_path "$path" || fail "a chosen file has an unsafe live parent; selection unchanged"
    test -e "$DOTS_HOME/$path" || test -L "$DOTS_HOME/$path" || continue
    test -f "$DOTS_HOME/$path" && test ! -L "$DOTS_HOME/$path" || fail "a chosen file exists locally but is not a regular file; selection unchanged"
    git_repo cat-file blob "$head:$path" 2>/dev/null | cmp -s - "$DOTS_HOME/$path" || printf '%s\n' "$path" >>"$temp/backup-paths"
  done <"$temp/newly-used"
  if test -s "$temp/backup-paths"; then
    say "These local files differ from the repository version:"
    sed 's/^/  /' "$temp/backup-paths"
    printf 'Back them up and use the repository version? [y/N] ' >&2
    IFS= read -r answer || fail "selection cancelled"
    case $answer in y|Y|yes|YES) ;; *) say "selection unchanged"; return 0 ;; esac
    backup_live_files "$temp/backup-paths" select || fail "could not back up local files; selection unchanged"
    # A file edited after its backup would lose that edit, so re-check just before replacing.
    while IFS= read -r path; do
      cmp -s "$BACKUP_DIR/$path" "$DOTS_HOME/$path" || fail "a local file changed during select; nothing was replaced (backup: $BACKUP_DIR)"
    done <"$temp/backup-paths"
  fi
  if test -s "$temp/newly-used"; then
    set --
    while IFS= read -r path; do set -- "$@" "$path"; done <"$temp/newly-used"
    git_repo checkout --quiet "$head" -- "$@" || fail "could not bring in the chosen files${BACKUP_DIR:+ (backup: $BACKUP_DIR)}"
  fi
  write_selection "$temp/chosen" "$temp/skip" "$temp/head-manifest" "$temp/pending" || fail "could not save the file selection"
  say "this Mac uses $(list_count "$temp/chosen") of $(list_count "$temp/head-manifest") repository file(s)"
}

case ${1:-} in
  init) shift; init_command "$@" ;;
  select) shift; select_command "$@" ;;
  status) shift; status_command "$@" ;;
  sync) shift; sync_command "$@" ;;
  update) shift; update_command "$@" ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 2 ;;
esac
