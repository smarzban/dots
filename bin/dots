#!/bin/bash
# dots: intentionally small, allowlist-only dotfile synchronization.
# Compatible with macOS /bin/bash 3.2.

set -u
umask 077
# Never allow a Git pager to consume sync confirmation input on a terminal.
GIT_PAGER='cat'
# Do not let a managed $HOME/.gitconfig alter dots' own Git operations.
GIT_CONFIG_GLOBAL=/dev/null
export GIT_PAGER GIT_CONFIG_GLOBAL

DOTS_HOME=${HOME:?HOME must be set}
DOTS_DATA=${DOTS_DATA_DIR:-"$DOTS_HOME/.local/share/dots"}
REPO="$DOTS_DATA/repo.git"
GIT=${DOTS_GIT:-/usr/bin/git}
GITLEAKS=${DOTS_GITLEAKS:-gitleaks}
GH=${DOTS_GH:-gh}
# Test and self-hosting overrides. Normal no-argument init derives its owner from gh.
DEFAULT_REMOTE=${DOTS_DEFAULT_REMOTE:-}
DEFAULT_GITHUB_REPO=${DOTS_DEFAULT_GITHUB_REPO:-}
DEFAULT_GITHUB_REPO_NAME=${DOTS_DEFAULT_GITHUB_REPO_NAME:-dotfiles}
MANIFEST=.config/dots/manifest

say() { printf '%s\n' "$*"; }
fail() { printf 'dots: %s\n' "$*" >&2; exit 1; }
usage() { cat <<'EOF'
Usage:
  dots init [--discover] [remote] [branch]
  dots status
  dots sync [--continue]
  dots update
EOF
}

require_tool() {
  case $1 in
    */*) test -x "$1" || fail "required dependency is unavailable: $1" ;;
    *) command -v "$1" >/dev/null 2>&1 || fail "required dependency is unavailable: $1" ;;
  esac
}

require_dependencies() {
  require_tool "$GIT"
  require_tool "$GITLEAKS"
}

git_repo() { "$GIT" --no-pager --git-dir="$REPO" --work-tree="$DOTS_HOME" "$@"; }
git_dir() { "$GIT" --no-pager --git-dir="$1" "${@:2}"; }

safe_branch() {
  "$GIT" check-ref-format --branch "$1" >/dev/null 2>&1 || fail "invalid branch name"
}

mktemp_dir() {
  mktemp -d "${TMPDIR:-/tmp}/dots.XXXXXX" || fail "cannot create temporary directory"
}

valid_manifest_path() {
  line=$1
  test -n "$line" || return 1
  # v1 paths are printable ASCII. This avoids ambiguous Unicode whitespace and
  # platform-dependent normalization, as well as unsafe Git pathspec characters.
  printf '%s' "$line" | LC_ALL=C grep '[^ -~]' >/dev/null && return 1
  case $line in
    '#'*|:*|*'\\'*|.gitleaks.toml|/*|./*|*/|*'//'*|*'..'*|*'?'*|*'*'*|*'['*|*']'*|*'{'*|*'}'*) return 1 ;;
  esac
  case "/$line/" in */./*|*/../*) return 1 ;; esac
  case $line in *' '*|*$'\t'*) return 1 ;; esac
  return 0
}

# A manifest is parsed into a private newline-delimited file. Paths cannot contain
# controls, so this representation is unambiguous.
validate_manifest_file() {
  manifest_file=$1
  out_file=$2
  test -f "$manifest_file" && test ! -L "$manifest_file" || return 1
  : >"$out_file" || return 1
  while IFS= read -r line || test -n "$line"; do
    case $line in ''|'#'*) continue ;; esac
    valid_manifest_path "$line" || return 1
    grep -F -x -- "$line" "$out_file" >/dev/null 2>&1 && return 1
    printf '%s\n' "$line" >>"$out_file" || return 1
  done <"$manifest_file"
  return 0
}

# Reject symlinked parents as well as a symlink at the final name. This prevents an
# allowlisted relative path from escaping HOME through an existing parent link.
safe_live_path() {
  rel=$1
  current=$DOTS_HOME
  oldifs=$IFS
  IFS=/
  set -- $rel
  IFS=$oldifs
  remaining=$#
  for component in "$@"; do
    current=$current/$component
    remaining=$((remaining - 1))
    if test -L "$current"; then return 1; fi
    if test "$remaining" -gt 0 && test -e "$current" && test ! -d "$current"; then return 1; fi
  done
  return 0
}

is_reserved_path() {
  path=$1
  case $DOTS_DATA in
    "$DOTS_HOME"/*)
      data_path=${DOTS_DATA#"$DOTS_HOME"/}
      test "$path" = "$data_path" && return 0
      case $path in "$data_path"/*) return 0 ;; esac
      ;;
  esac
  return 1
}

validate_live_paths() {
  list=$1
  safe_live_path "$MANIFEST" || return 1
  is_reserved_path "$MANIFEST" && return 1
  test -f "$DOTS_HOME/$MANIFEST" && test ! -L "$DOTS_HOME/$MANIFEST" || return 1
  while IFS= read -r path; do
    is_reserved_path "$path" && return 1
    safe_live_path "$path" || return 1
    if test -e "$DOTS_HOME/$path" && { test -d "$DOTS_HOME/$path" || test -L "$DOTS_HOME/$path"; }; then return 1; fi
  done <"$list"
  return 0
}

manifest_from_revision() {
  gitdir=$1
  rev=$2
  out=$3
  tmp=$4
  git_dir "$gitdir" show "$rev:$MANIFEST" >"$tmp" 2>/dev/null || return 1
  validate_manifest_file "$tmp" "$out"
}

path_in_list() { grep -F -x -- "$1" "$2" >/dev/null 2>&1; }

# Check the entire candidate tree. Git path output is NUL-delimited, and failures
# intentionally do not repeat an untrusted filename or file body.
validate_tree() {
  gitdir=$1
  rev=$2
  list=$3
  temp=$4
  manifest_from_revision "$gitdir" "$rev" "$list" "$temp/manifest" || return 1
  entry_file=$temp/tree
  git_dir "$gitdir" ls-tree -r -z "$rev" >"$entry_file" || return 1
  while IFS= read -r -d '' entry; do
    meta=${entry%%$'\t'*}
    path=${entry#*$'\t'}
    mode=${meta%% *}
    test "$path" = "$MANIFEST" && {
      test "$mode" = 100644 -o "$mode" = 100755 || return 1
      continue
    }
    test "$mode" = 100644 -o "$mode" = 100755 || return 1
    path_in_list "$path" "$list" || return 1
  done <"$entry_file"
  # A candidate manifest cannot approve nonexistent paths, which would otherwise
  # make the later path-limited checkout fail after repository metadata is moved.
  while IFS= read -r path; do
    is_reserved_path "$path" && return 1
    git_dir "$gitdir" cat-file -e "$rev:$path" 2>/dev/null || return 1
  done <"$list"
  return 0
}

scan_git_revision() {
  gitdir=$1
  rev=$2
  # gitleaks receives only a revision, its report is suppressed and fully redacted.
  (unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML; "$GITLEAKS" git --no-banner --no-color --redact=100 --config /dev/null --log-opts "$rev" "$gitdir" >/dev/null 2>&1)
}

copy_live_candidates_for_scan() {
  list=$1
  destination=$2
  while IFS= read -r path; do
    test -e "$DOTS_HOME/$path" || continue
    test -f "$DOTS_HOME/$path" && test ! -L "$DOTS_HOME/$path" || return 1
    mkdir -p "$destination/$(dirname "$path")" || return 1
    cp -p "$DOTS_HOME/$path" "$destination/$path" || return 1
  done <"$list"
}

scan_live_candidates() {
  list=$1
  temp=$2
  scan=$temp/live-scan
  mkdir -p "$scan" || return 1
  copy_live_candidates_for_scan "$list" "$scan" || return 1
  (unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML; "$GITLEAKS" dir --no-banner --no-color --redact=100 --config /dev/null "$scan" >/dev/null 2>&1)
}

scan_directory() {
  (unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML; "$GITLEAKS" dir --no-banner --no-color --redact=100 --config /dev/null "$1" >/dev/null 2>&1)
}

append_unique_list() {
  source=$1
  target=$2
  while IFS= read -r path; do
    path_in_list "$path" "$target" || printf '%s\n' "$path" >>"$target"
  done <"$source"
}

list_with_manifest() {
  list=$1
  out=$2
  : >"$out"
  printf '%s\n' "$MANIFEST" >>"$out"
  append_unique_list "$list" "$out"
}

current_branch() {
  git_repo config --get dots.branch 2>/dev/null
}

ensure_initialized() {
  test -d "$REPO" || fail "not initialized, run: dots init <remote> [branch]"
  test "$(git_repo config --get dots.initialized 2>/dev/null || true)" = true || fail "repository is not a completed dots initialization"
  branch=$(current_branch || true)
  test -n "$branch" || fail "repository has no configured branch"
  safe_branch "$branch"
}

live_manifest_list() {
  out=$1
  safe_live_path "$MANIFEST" || return 1
  validate_manifest_file "$DOTS_HOME/$MANIFEST" "$out"
}

head_revision() { git_repo rev-parse HEAD 2>/dev/null; }

validate_current_state() {
  temp=$1
  head=$(head_revision) || return 1
  validate_tree "$REPO" "$head" "$temp/head-manifest" "$temp" || return 1
  validate_live_paths "$temp/head-manifest" || return 1
  live_manifest_list "$temp/live-manifest" || return 1
  validate_live_paths "$temp/live-manifest" || return 1
  list_with_manifest "$temp/live-manifest" "$temp/live-paths"
  list_with_manifest "$temp/head-manifest" "$temp/head-paths"
  : >"$temp/all-paths"
  append_unique_list "$temp/head-paths" "$temp/all-paths"
  append_unique_list "$temp/live-paths" "$temp/all-paths"
}

show_changes() {
  paths=$1
  changes=$2
  # Construct one argv entry per approved path, never a broad pathspec.
  : >"$changes"
  set --
  while IFS= read -r path; do set -- "$@" "$path"; done <"$paths"
  git_repo status --porcelain --untracked-files=all -- "$@" >"$changes" || return 2
  test -s "$changes"
}

show_change_summary() {
  paths=$1
  changes=$2
  say "Approved changes (content is intentionally not printed):"
  cat "$changes"
  # Untracked files are represented by status above. Git's name-status covers tracked diffs.
  set --
  while IFS= read -r path; do set -- "$@" "$path"; done <"$paths"
  git_repo diff --name-status -- "$@" || return 1
}

stage_approved_paths() {
  old=$1
  new=$2
  # Do not accept a pre-existing partial index or conflict state.
  git_repo diff --cached --quiet || return 1
  git_repo diff --name-only --diff-filter=U | grep . >/dev/null 2>&1 && return 1
  set --
  while IFS= read -r path; do set -- "$@" "$path"; done <"$new"
  git_repo add -A -- "$@" || return 1
  # Removing an allowlist entry means removing it from the repository, not deleting
  # the live file. The old list is itself a validated manifest.
  while IFS= read -r path; do
    test "$path" = "$MANIFEST" && continue
    path_in_list "$path" "$new" && continue
    git_repo rm --cached --ignore-unmatch -- "$path" >/dev/null || return 1
  done <"$old"
  return 0
}

ensure_identity() {
  git_repo var GIT_AUTHOR_IDENT >/dev/null 2>&1 || return 1
}

safe_github_component() {
  test -n "$1" || return 1
  case $1 in *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-]*) return 1 ;; esac
  return 0
}

github_repository_from_gh() {
  require_tool "$GH"
  "$GH" auth status >/dev/null 2>&1 || return 1
  owner=$("$GH" api user --jq .login 2>/dev/null) || return 1
  safe_github_component "$owner" || return 1
  safe_github_component "$DEFAULT_GITHUB_REPO_NAME" || return 1
  printf '%s/%s\n' "$owner" "$DEFAULT_GITHUB_REPO_NAME"
}

enable_gh_git_credentials() {
  # We ignore a managed ~/.gitconfig, but gh's credential helper is still needed
  # for the account-derived HTTPS remote. Git 2.18+ supports this env interface.
  GIT_CONFIG_COUNT=1
  GIT_CONFIG_KEY_0=credential.helper
  GIT_CONFIG_VALUE_0='!gh auth git-credential'
  export GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0
}

# A newly created remote needs one safe, versioned object before init can validate it.
# This is metadata bootstrap, not a configuration template or an import of HOME.
seed_new_repository() {
  remote=$1
  branch=$2
  seed=$3
  "$GIT" init --quiet "$seed" || return 1
  "$GIT" -C "$seed" config user.name "dots bootstrap" || return 1
  "$GIT" -C "$seed" config user.email "dots@local.invalid" || return 1
  mkdir -p "$seed/.config/dots" || return 1
  : >"$seed/$MANIFEST" || return 1
  "$GIT" -C "$seed" add -- "$MANIFEST" || return 1
  "$GIT" -C "$seed" commit --quiet -m "Initialize dots manifest" || return 1
  "$GIT" -C "$seed" branch -M "$branch" || return 1
  "$GIT" -C "$seed" remote add origin "$remote" || return 1
  "$GIT" -C "$seed" push --quiet origin "HEAD:refs/heads/$branch"
}

create_default_github_repository() {
  remote=$1
  github_repository=$2
  branch=$3
  temp=$4
  require_tool "$GH"
  "$GH" auth status >/dev/null 2>&1 || fail "GitHub CLI is not authenticated; run gh auth login or pass an explicit remote"
  if "$GH" repo view "$github_repository" --json nameWithOwner >/dev/null 2>&1; then
    fail "could not clone the existing default repository; check network access and permissions"
  fi
  test -t 0 && test -t 1 || fail "default repository is missing; rerun dots init from an interactive terminal to create it"
  printf 'GitHub repository %s is unavailable. Create it privately with an empty dots manifest? [y/N] ' "$github_repository" >&2
  IFS= read -r answer || fail "repository creation cancelled"
  case $answer in y|Y|yes|YES) ;; *) say "init cancelled"; exit 0 ;; esac
  "$GH" repo create "$github_repository" --private --description "Allowlisted dots configuration" >/dev/null 2>&1 || fail "could not create private GitHub repository $github_repository"
  seed_new_repository "$remote" "$branch" "$temp/seed" || fail "repository was created but its initial manifest could not be pushed"
  say "created private GitHub repository $github_repository"
  return 0
}

candidate_is_excluded() {
  path=$1
  # Names only, conservative exclusions for secrets and machine-local state.
  case $path in
    .config/dots/*|.config/gh/*|.config/mcp/*|.config/browser-harness/*|.config/cagent/*|.config/configstore/*|.config/origin-cli/*|.config/pass/*|.config/vercel-plugin/*|.config/zed/prompts/*|.config/herdr/release-notes.json|.config/herdr/tsk-plugins/*|.config/chezmoi/*|.config/uv/*|*/.git/*|*/.system/*|*/auth*|*/credentials*|*token*|*secret*|*password*|*.env|*/cache/*|*/logs/*|*/log/*|*/runtime/*|*/tmp/*|*/backups/*|*history*|*session*|*state*|*.db|*.sqlite*|*.lock|*.log|*.pid|*.bak|*backup*) return 0 ;;
  esac
  return 1
}

add_candidate() {
  path=$1
  approved=$2
  out=$3
  test -f "$DOTS_HOME/$path" && test ! -L "$DOTS_HOME/$path" || return 0
  valid_manifest_path "$path" || return 0
  is_reserved_path "$path" && return 0
  candidate_is_excluded "$path" && return 0
  path_in_list "$path" "$approved" && return 0
  printf '%s\n' "$path" >>"$out"
}

collect_candidates() {
  approved=$1
  out=$2
  : >"$out" || return 1
  for path in .gitconfig .bash_profile .profile .tcshrc .zshenv .zshrc .claude/settings.json .claude/statusline-command.sh .codex/AGENTS.md .codex/config.toml .codex/hooks.json .codex/keybindings.json .codex/rules/default.rules .cursor/argv.json .cursor/cli-config.json .cursor/hooks.json .cursor/statusline.sh .grok/config.toml .grok/pager.toml .grok/statusline.sh .grokbot/settings.json .pi/agent/AGENTS.md .pi/agent/editor.json .pi/agent/settings.json .pi/agent/spawn.json .pi/agent/statusline.json .pi/agent/toolview.json .pi/web-search.json .pi/workflows/model-tiers.json .pi/workflows/settings.json; do
    add_candidate "$path" "$approved" "$out"
  done
  for directory in .claude/hooks .cursor/agents .cursor/rules .grok/hooks .pi/agent/agents .pi/agent/extensions .pi/agent/themes; do
    test -d "$DOTS_HOME/$directory" && test ! -L "$DOTS_HOME/$directory" || continue
    find "$DOTS_HOME/$directory" -type f -print 2>/dev/null | while IFS= read -r absolute; do
      path=${absolute#"$DOTS_HOME"/}
      add_candidate "$path" "$approved" "$out"
    done
  done
  for directory in .claude/skills .codex/skills .cursor/skills .grok/skills; do
    test -d "$DOTS_HOME/$directory" && test ! -L "$DOTS_HOME/$directory" || continue
    find "$DOTS_HOME/$directory" -type f -name SKILL.md -print 2>/dev/null | while IFS= read -r absolute; do
      path=${absolute#"$DOTS_HOME"/}
      add_candidate "$path" "$approved" "$out"
    done
  done
  if test -d "$DOTS_HOME/.config" && test ! -L "$DOTS_HOME/.config"; then
    find "$DOTS_HOME/.config" -type f -print 2>/dev/null | while IFS= read -r absolute; do
      path=${absolute#"$DOTS_HOME"/}
      add_candidate "$path" "$approved" "$out"
    done
  fi
  sort -u "$out" -o "$out"
}

print_candidates() {
  candidates=$1
  count=$(wc -l <"$candidates" | tr -d ' ')
  test "$count" -gt 0 || { say "No unapproved, low-risk configuration candidates found."; return 0; }
  say "Candidate configuration files (names only):"
  awk '{ printf "%3d  %s\n", NR, $0 }' "$candidates"
}

select_candidates() {
  candidates=$1
  temp=$2
  selected=$temp/selected
  : >"$selected"
  count=$(wc -l <"$candidates" | tr -d ' ')
  print_candidates "$candidates"
  test "$count" -gt 0 || return 0
  printf 'Select files for the update PR (for example 1,3-5, Enter for none): ' >&2
  IFS= read -r selection || fail "candidate selection cancelled"
  test -n "$selection" || { say "no files selected"; return 0; }
  case $selection in ,*|*,|*,,*|*[!0-9,-]*) fail "selection must contain only numbers, commas, and ranges" ;; esac
  oldifs=$IFS
  IFS=,
  set -- $selection
  IFS=$oldifs
  for item in "$@"; do
    case $item in
      *-*) start=${item%-*}; finish=${item#*-}; test -n "$start" && test -n "$finish" && test "$start" -le "$finish" || fail "invalid selection range" ;;
      *) start=$item; finish=$item ;;
    esac
    test "$start" -ge 1 2>/dev/null && test "$finish" -le "$count" 2>/dev/null || fail "selection is out of range"
    number=$start
    while test "$number" -le "$finish"; do
      path=$(sed -n "${number}p" "$candidates") || fail "could not read selected candidate"
      path_in_list "$path" "$selected" && fail "selection contains a duplicate"
      printf '%s\n' "$path" >>"$selected"
      number=$((number + 1))
    done
  done
  test -s "$selected" || { say "no files selected"; return 0; }
  say "Will include in the update PR:"
  cat "$selected"
  printf 'Include these paths? [y/N] ' >&2
  IFS= read -r answer || fail "candidate selection cancelled"
  case $answer in y|Y|yes|YES) ;; *) : >"$selected"; say "no candidates selected" ;; esac
}

preview_candidates() {
  temp=$1
  : >"$temp/preview-approved"
  collect_candidates "$temp/preview-approved" "$temp/candidates" || fail "could not collect candidates"
  print_candidates "$temp/candidates"
  say "Preview only, no files, manifest, repository, or network state changed."
}

build_manifest_with_selection() {
  current=$1
  selected=$2
  out=$3
  approved=$4
  cat "$current" >"$out" || return 1
  while IFS= read -r path; do
    path_in_list "$path" "$approved" || printf '%s\n' "$path" >>"$out"
  done <"$selected"
  validate_manifest_file "$out" "$out.validated"
}

configure_sandbox_identity() {
  sandbox=$1
  ensure_identity || return 1
  name=$(git_repo config --get user.name 2>/dev/null || true)
  email=$(git_repo config --get user.email 2>/dev/null || true)
  test -z "$name" || "$GIT" -C "$sandbox" config user.name "$name" || return 1
  test -z "$email" || "$GIT" -C "$sandbox" config user.email "$email" || return 1
}

configure_merge_identity() {
  "$GIT" -C "$1" config user.name "dots temporary merge" || return 1
  "$GIT" -C "$1" config user.email "dots@local.invalid"
}

prepare_local_sandbox() {
  sandbox=$1
  live_paths=$3
  all_paths=$4
  proposed_manifest=$5
  while IFS= read -r path; do
    if test "$path" = "$MANIFEST"; then
      mkdir -p "$sandbox/$(dirname "$path")" || return 1
      cp -p "$proposed_manifest" "$sandbox/$path" || return 1
    elif path_in_list "$path" "$live_paths"; then
      test -f "$DOTS_HOME/$path" && test ! -L "$DOTS_HOME/$path" || return 1
      mkdir -p "$sandbox/$(dirname "$path")" || return 1
      cp -p "$DOTS_HOME/$path" "$sandbox/$path" || return 1
    else
      "$GIT" -C "$sandbox" rm -f --ignore-unmatch -- "$path" >/dev/null || return 1
    fi
  done <"$all_paths"
  set --
  while IFS= read -r path; do set -- "$@" "$path"; done <"$all_paths"
  "$GIT" -C "$sandbox" add -A -- "$@"
}

copy_sandbox_paths_to_home() {
  sandbox=$1
  paths=$2
  while IFS= read -r path; do
    safe_live_path "$path" || return 1
    test -f "$sandbox/$path" && test ! -L "$sandbox/$path" || return 1
    mkdir -p "$DOTS_HOME/$(dirname "$path")" || return 1
    cp -p "$sandbox/$path" "$DOTS_HOME/$path" || return 1
  done <"$paths"
}

advance_to_remote_revision() {
  branch=$1
  remote=$2
  git_repo update-ref "refs/heads/$branch" "$remote" || return 1
  git_repo symbolic-ref HEAD "refs/heads/$branch" || return 1
  git_repo read-tree "$remote"
}

check_new_tree_collisions() {
  gitdir=$1
  base=$2
  candidate=$3
  temp=$4
  # Both trees were validated, so their names contain no controls and can safely
  # use line-oriented system tools (BSD grep has no -z option).
  git_dir "$gitdir" ls-tree -r --name-only "$base" >"$temp/base-names" || return 1
  git_dir "$gitdir" ls-tree -r --name-only "$candidate" >"$temp/candidate-names" || return 1
  while IFS= read -r path; do
    grep -F -x -- "$path" "$temp/base-names" >/dev/null 2>&1 && continue
    test "$path" = "$MANIFEST" && continue
    safe_live_path "$path" || return 1
    test -e "$DOTS_HOME/$path" && return 1
  done <"$temp/candidate-names"
  return 0
}

init_command() {
  if test "${1:-}" = --discover; then
    shift
    test $# -eq 0 || { usage >&2; exit 2; }
    temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
    preview_candidates "$temp"
    exit 0
  fi
  test $# -le 2 || { usage >&2; exit 2; }
  auto_default=false
  if test $# -eq 0 && test -e "$REPO"; then
    # Repeating init must not require gh merely to rediscover an existing remote.
    remote=$(git_repo remote get-url origin 2>/dev/null || true)
    test -n "$remote" || fail "existing repository has no origin remote"
    github_repository=
  elif test $# -eq 0; then
    auto_default=true
    if test -n "$DEFAULT_REMOTE" && test -n "$DEFAULT_GITHUB_REPO"; then
      remote=$DEFAULT_REMOTE
      github_repository=$DEFAULT_GITHUB_REPO
    else
      github_repository=$(github_repository_from_gh) || fail "GitHub CLI is unavailable, unauthenticated, or returned an unsafe account name"
      remote=https://github.com/$github_repository.git
      enable_gh_git_credentials
      private=$("$GH" repo view "$github_repository" --json isPrivate --jq .isPrivate 2>/dev/null || true)
      test -z "$private" -o "$private" = true || fail "default GitHub repository must be private"
    fi
  else
    remote=$1
    github_repository=
  fi
  requested_branch=${2:-}
  test -n "$requested_branch" && safe_branch "$requested_branch"
  require_dependencies
  if test -e "$REPO"; then
    ensure_initialized
    existing_remote=$(git_repo remote get-url origin 2>/dev/null || true)
    test "$existing_remote" = "$remote" || fail "already initialized with a different remote; use dots sync or remove the data directory deliberately"
    branch=$(current_branch)
    test -z "$requested_branch" -o "$requested_branch" = "$branch" || fail "already initialized with a different branch"
    temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
    validate_current_state "$temp" || fail "existing repository or live manifest is unsafe"
    say "already initialized on $branch; no live files changed"
    exit 0
  fi
  mkdir -p "$DOTS_DATA" || fail "cannot create data directory"
  temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
  candidate_repo=$temp/repo.git
  # The no-argument default is an account-derived private GitHub repository. For a
  # missing default, gh can create a minimal safe repository after confirmation.
  branch=${requested_branch:-main}
  safe_branch "$branch"
  created_default=false
  if ! "$GIT" clone --bare -- "$remote" "$candidate_repo" >/dev/null 2>&1; then
    test "$auto_default" = true || fail "could not clone remote"
    create_default_github_repository "$remote" "$github_repository" "$branch" "$temp"
    created_default=true
    "$GIT" clone --bare -- "$remote" "$candidate_repo" >/dev/null 2>&1 || fail "could not clone newly created remote"
  fi
  if test -z "$requested_branch" && test "$created_default" != true; then
    branch=$(git_dir "$candidate_repo" symbolic-ref --short HEAD 2>/dev/null || true)
    test -n "$branch" || fail "remote has no usable default branch; specify a branch"
    safe_branch "$branch"
  fi
  git_dir "$candidate_repo" fetch --no-tags origin "refs/heads/$branch:refs/heads/$branch" >/dev/null 2>&1 || fail "could not fetch requested branch"
  revision=$(git_dir "$candidate_repo" rev-parse "refs/heads/$branch" 2>/dev/null) || fail "requested branch has no revision"
  validate_tree "$candidate_repo" "$revision" "$temp/manifest-paths" "$temp" || fail "candidate manifest or repository tree is unsafe"
  scan_git_revision "$candidate_repo" "$revision" || fail "credential scan failed for candidate revision"
  # Every target, including the manifest, must be absent for a first initialization.
  list_with_manifest "$temp/manifest-paths" "$temp/candidate-paths"
  while IFS= read -r path; do
    safe_live_path "$path" || fail "candidate path has an unsafe live parent"
    test ! -e "$DOTS_HOME/$path" && test ! -L "$DOTS_HOME/$path" || fail "refusing to overwrite an existing live file"
  done <"$temp/candidate-paths"
  mv "$candidate_repo" "$REPO" || fail "could not install repository metadata"
  git_repo config status.showUntrackedFiles no || fail "could not configure repository"
  git_repo config dots.branch "$branch" || fail "could not record branch"
  git_repo update-ref "refs/heads/$branch" "$revision" || fail "could not set requested branch"
  git_repo symbolic-ref HEAD "refs/heads/$branch" || fail "could not select requested branch"
  # Checkout only validated, explicit paths. This is never a broad checkout.
  set --
  while IFS= read -r path; do set -- "$@" "$path"; done <"$temp/candidate-paths"
  git_repo checkout --quiet "$revision" -- "$@" || fail "checkout failed after preflight; inspect live files before retrying"
  git_repo config dots.initialized true || fail "could not finalize initialization"
  say "initialized $branch at $revision"
}

status_command() {
  test $# -eq 0 || { usage >&2; exit 2; }
  require_dependencies
  ensure_initialized
  temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
  validate_current_state "$temp" || fail "repository tree or live manifest is unsafe"
  branch=$(current_branch)
  head=$(head_revision) || fail "cannot resolve current revision"
  git_repo fetch --no-tags origin "refs/heads/$branch:refs/remotes/origin/$branch" >/dev/null 2>&1 || fail "could not fetch remote status"
  remote=$(git_repo rev-parse "refs/remotes/origin/$branch" 2>/dev/null) || fail "remote branch is unavailable"
  counts=$(git_repo rev-list --left-right --count "$head...$remote" 2>/dev/null) || fail "cannot compute divergence"
  set -- $counts
  say "initialized: yes"
  say "branch: $branch"
  say "revision: $head"
  say "divergence: ahead $1, behind $2"
  if show_changes "$temp/all-paths" "$temp/changes"; then
    say "tracked configuration changes:"
    cat "$temp/changes"
  else
    result=$?
    test "$result" -eq 1 || fail "could not inspect approved configuration changes"
    say "tracked configuration changes: none"
  fi
}

fetch_validated_remote() {
  temp=$1
  branch=$2
  git_repo fetch --no-tags origin "refs/heads/$branch:refs/remotes/origin/$branch" >/dev/null 2>&1 || return 1
  remote=$(git_repo rev-parse "refs/remotes/origin/$branch" 2>/dev/null) || return 1
  validate_tree "$REPO" "$remote" "$temp/remote-manifest" "$temp" || return 1
  scan_git_revision "$REPO" "$remote" || return 1
  printf '%s\n' "$remote"
}

apply_workspace_result() {
  workspace=$1
  tree=$2
  remote=$3
  base=$4
  branch=$5
  temp=$6
  validate_tree "$workspace/.git" "$tree" "$temp/result-manifest" "$temp" || return 1
  list_with_manifest "$temp/result-manifest" "$temp/result-paths"
  scan_directory "$workspace" || return 1
  check_new_tree_collisions "$workspace/.git" "$base" "$tree" "$temp" || return 1
  copy_sandbox_paths_to_home "$workspace" "$temp/result-paths" || return 1
  advance_to_remote_revision "$branch" "$remote"
}

sync_continue_command() {
  test $# -eq 1 && test "$1" = --continue || { usage >&2; exit 2; }
  require_dependencies
  ensure_initialized
  workspace=$DOTS_DATA/conflict-workspace
  test -d "$workspace/.git" || fail "no pending conflict workspace"
  "$GIT" -C "$workspace" diff --name-only --diff-filter=U | grep . >/dev/null 2>&1 && fail "resolve all conflicts in $workspace before continuing"
  test -z "$("$GIT" -C "$workspace" status --porcelain)" || fail "commit the conflict resolution in $workspace before continuing"
  remote=$("$GIT" -C "$workspace" config --get dots.remoteRevision 2>/dev/null || true)
  base=$("$GIT" -C "$workspace" config --get dots.baseRevision 2>/dev/null || true)
  test -n "$remote" && test -n "$base" || fail "conflict workspace metadata is unsafe"
  temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
  branch=$(current_branch)
  tree=$("$GIT" -C "$workspace" rev-parse 'HEAD^{tree}' 2>/dev/null) || fail "could not read resolved workspace"
  apply_workspace_result "$workspace" "$tree" "$remote" "$base" "$branch" "$temp" || fail "resolved workspace is unsafe"
  rm -rf "$workspace"
  say "resolved merge applied locally, no remote changes were pushed"
}

sync_command() {
  if test "${1:-}" = --continue; then sync_continue_command "$@"; return; fi
  test $# -eq 0 || { usage >&2; exit 2; }
  require_dependencies
  ensure_initialized
  test -t 0 && test -t 1 || fail "sync requires an interactive terminal"
  temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
  validate_current_state "$temp" || fail "repository tree or live manifest is unsafe"
  git_repo diff --cached --quiet || fail "repository index has staged changes; resolve or unstage them before sync"
  git_repo diff --name-only --diff-filter=U | grep . >/dev/null 2>&1 && fail "repository index has conflicts; resolve them before sync"
  scan_live_candidates "$temp/live-paths" "$temp" || fail "credential scan failed for local candidates"
  branch=$(current_branch)
  base=$(head_revision) || fail "cannot resolve current revision"
  remote=$(fetch_validated_remote "$temp" "$branch") || fail "incoming repository data is unsafe or unavailable"
  git_repo merge-base --is-ancestor "$base" "$remote" || test "$base" = "$remote" || fail "remote history is not a safe fast-forward"
  has_local=false
  if show_changes "$temp/all-paths" "$temp/changes"; then has_local=true; show_change_summary "$temp/all-paths" "$temp/changes"; else result=$?; test "$result" -eq 1 || fail "could not inspect approved configuration changes"; fi
  remote_workspace=$temp/remote-workspace
  "$GIT" clone --quiet --no-checkout -- "$REPO" "$remote_workspace" || fail "could not prepare remote workspace"
  "$GIT" -C "$remote_workspace" checkout --quiet "$remote" || fail "could not prepare remote revision"
  if test "$has_local" = false; then
    apply_workspace_result "$remote_workspace" "${remote}^{tree}" "$remote" "$base" "$branch" "$temp" || fail "could not apply remote configuration"
    say "sync complete, repository configuration applied locally"
    return
  fi
  say "Local approved changes are not pushed by sync:"
  say "  1. Use repository version, replace local files"
  say "  2. Keep local files, make no changes"
  say "  3. Create a PR from local changes"
  test "$base" = "$remote" || say "  4. Merge remote into local only"
  printf 'Choose [1-4]: ' >&2
  IFS= read -r choice || fail "sync choice cancelled"
  case $choice in
    1) apply_workspace_result "$remote_workspace" "${remote}^{tree}" "$remote" "$base" "$branch" "$temp" || fail "could not apply repository configuration"; say "repository configuration applied locally" ;;
    2) say "local files kept, no changes made" ;;
    3) update_command ;;
    4)
      test "$base" != "$remote" || fail "there are no remote changes to merge"
      workspace=$DOTS_DATA/conflict-workspace
      test ! -e "$workspace" || fail "a conflict workspace already exists: $workspace"
      "$GIT" clone --quiet --no-checkout -- "$REPO" "$workspace" || fail "could not create conflict workspace"
      "$GIT" -C "$workspace" checkout --quiet "$base" || fail "could not prepare conflict workspace"
      configure_merge_identity "$workspace" || fail "could not configure temporary merge workspace"
      prepare_local_sandbox "$workspace" "$temp/head-paths" "$temp/live-paths" "$temp/all-paths" "$DOTS_HOME/$MANIFEST" || fail "could not prepare local merge candidate"
      "$GIT" -C "$workspace" commit --quiet -m "dots local changes" || fail "could not prepare local merge candidate"
      "$GIT" -C "$workspace" config dots.remoteRevision "$remote"
      "$GIT" -C "$workspace" config dots.baseRevision "$base"
      if ! GIT_MERGE_AUTOEDIT=no "$GIT" -C "$workspace" merge --no-commit --no-ff "$remote" >/dev/null 2>&1; then
        say "merge conflict workspace: $workspace"
        "$GIT" -C "$workspace" diff --name-only --diff-filter=U
        say "resolve and commit there, then run: dots sync --continue"
        return
      fi
      tree=$("$GIT" -C "$workspace" write-tree 2>/dev/null) || fail "could not prepare merged configuration"
      apply_workspace_result "$workspace" "$tree" "$remote" "$base" "$branch" "$temp" || fail "merged configuration is unsafe"
      rm -rf "$workspace"
      say "merged remote configuration into local files only" ;;
    *) fail "invalid sync choice" ;;
  esac
}

update_command() {
  test $# -eq 0 || { usage >&2; exit 2; }
  require_dependencies
  require_tool "$GH"
  ensure_initialized
  test -t 0 && test -t 1 || fail "update requires an interactive terminal"
  "$GH" auth status >/dev/null 2>&1 || fail "GitHub CLI is not authenticated"
  temp=$(mktemp_dir); trap 'rm -rf "$temp"' EXIT HUP INT TERM
  validate_current_state "$temp" || fail "repository tree or live manifest is unsafe"
  branch=$(current_branch)
  base=$(head_revision) || fail "cannot resolve current revision"
  remote=$(fetch_validated_remote "$temp" "$branch") || fail "incoming repository data is unsafe or unavailable"
  collect_candidates "$temp/live-manifest" "$temp/candidates" || fail "could not collect candidates"
  select_candidates "$temp/candidates" "$temp"
  build_manifest_with_selection "$DOTS_HOME/$MANIFEST" "$temp/selected" "$temp/proposed-manifest" "$temp/live-manifest" || fail "could not build proposed manifest"
  validate_manifest_file "$temp/proposed-manifest" "$temp/proposed-list" || fail "proposed manifest is unsafe"
  list_with_manifest "$temp/proposed-list" "$temp/proposed-paths"
  : >"$temp/update-paths"
  append_unique_list "$temp/head-paths" "$temp/update-paths"
  append_unique_list "$temp/proposed-paths" "$temp/update-paths"
  scan_live_candidates "$temp/proposed-paths" "$temp" || fail "credential scan failed for local update candidates"
  update_workspace=$temp/update-workspace
  "$GIT" clone --quiet --no-checkout -- "$REPO" "$update_workspace" || fail "could not prepare update workspace"
  "$GIT" -C "$update_workspace" checkout --quiet "$base" || fail "could not prepare update base"
  configure_sandbox_identity "$update_workspace" || fail "Git author identity is required for an update PR"
  prepare_local_sandbox "$update_workspace" "$temp/head-paths" "$temp/proposed-paths" "$temp/update-paths" "$temp/proposed-manifest" || fail "could not prepare local update"
  "$GIT" -C "$update_workspace" diff --cached --quiet && { say "no local changes or candidates to update"; return; }
  printf 'PR title: ' >&2
  IFS= read -r title || fail "PR title cancelled"
  test -n "$title" || fail "PR title is required"
  update_branch=dots/update-$(date +%Y%m%d%H%M%S)
  "$GIT" -C "$update_workspace" checkout -qb "$update_branch" || fail "could not create update branch"
  "$GIT" -C "$update_workspace" commit --quiet -m "$title" || fail "could not create update commit"
  tree=$("$GIT" -C "$update_workspace" rev-parse 'HEAD^{tree}') || fail "could not read update tree"
  validate_tree "$update_workspace/.git" "$tree" "$temp/update-manifest" "$temp" || fail "update tree is unsafe"
  scan_directory "$update_workspace" || fail "credential scan failed for update"
  origin=$(git_repo remote get-url origin 2>/dev/null || true)
  case $origin in
    https://github.com/*/*.git) repo_name=${origin#https://github.com/}; repo_name=${repo_name%.git} ;;
    git@github.com:*/*.git) repo_name=${origin#git@github.com:}; repo_name=${repo_name%.git} ;;
    *) fail "update PRs require a GitHub origin remote" ;;
  esac
  safe_github_component "${repo_name%%/*}" && safe_github_component "${repo_name##*/}" || fail "origin is not an accessible GitHub repository"
  "$GH" repo view "$repo_name" --json nameWithOwner >/dev/null 2>&1 || fail "origin is not an accessible GitHub repository"
  enable_gh_git_credentials
  "$GIT" -C "$update_workspace" push --quiet origin "$update_branch" || fail "could not push update branch"
  "$GH" pr create --repo "$repo_name" --base "$branch" --head "$update_branch" --title "$title" --body "Created by dots update." || fail "branch was pushed but PR creation failed"
  say "update PR created, local files and manifest remain unchanged"
}

case ${1:-} in
  init) shift; init_command "$@" ;;
  status) shift; status_command "$@" ;;
  sync) shift; sync_command "$@" ;;
  update) shift; update_command "$@" ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 2 ;;
esac
